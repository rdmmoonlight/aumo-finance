<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>3b80a545-4808-45e1-aed8-8b28c45e72fe</UserSecretsId>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <RustBuildMode Condition="'$(Configuration)' == 'Release'">--release</RustBuildMode>
    <RustTargetDir Condition="'$(Configuration)' == 'Release'">release</RustTargetDir>
    <RustTargetDir Condition="'$(Configuration)' != 'Release'">debug</RustTargetDir>
    <RustLibName Condition="$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))">aumo_core.dll</RustLibName>
    <RustLibName Condition="$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))">libaumo_core.dylib</RustLibName>
    <RustLibName Condition="$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Linux)))">libaumo_core.so</RustLibName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <GenerateProgramFile>false</GenerateProgramFile>
    <OpenApiGenerateXmlComments>false</OpenApiGenerateXmlComments>
    <NoWarn>$(NoWarn);NU1903;CS1030</NoWarn>
    <DefaultItemExcludes>$(DefaultItemExcludes);Controllers/Reports/FinancialStatementsController.cs;Services/Reports/FinancialStatements/**/*.cs;Controllers/Reports/JournalsController.cs;Services/Reports/Journals/**/*.cs</DefaultItemExcludes>
  </PropertyGroup>

  <!-- Isolasi Build: Exclude modul Financial Statements & Journals yang belum siap -->
  <ItemGroup>
    <!-- Microsoft / EF Core / Identity Package -->
    <PackageReference Include="AWSSDK.Core" Version="4.0.3.3" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.25" />
    <PackageReference Include="Hangfire.PostgreSql" Version="1.21.1" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.0-preview.1.25120.3" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.0-preview.1.25120.3" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0-preview.1.25120.3" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.0-preview.1.25120.3" />
    <PackageReference Include="Google.Apis.Auth" Version="1.68.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.0-preview.1.25081.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- Native OpenAPI Support & Modern UI -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0-preview.1.25120.3" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.0.0-preview5" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.12" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.0.*" />

    <!-- PostgreSQL Provider -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0-preview.1" />

    <!-- Utility & Third-Party Libraries -->
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="ExcelDataReader" Version="3.7.0" />
    <PackageReference Include="ExcelDataReader.DataSet" Version="3.7.0" />
    <PackageReference Include="CloudinaryDotNet" Version="1.27.4" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.0.1" />

    <!-- Testing Packages -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Moq" Version="4.20.72" />
  </ItemGroup>

  <!-- Target Kompilasi Cargo & Copy Dynamic Library ke OutDir Lokal -->
  <Target Name="BuildRustFFI" BeforeTargets="BeforeBuild">
    <Message Text="[RUST FFI] Mengompilasi C-Shared Library Rust ($(Configuration))..." Importance="high" />
    <Exec Command="cargo build $(RustBuildMode) --manifest-path ../axum/Cargo.toml" />

    <!-- Copy File Shared Library ke Target Directory Build .NET -->
    <Copy SourceFiles="../axum/target/$(RustTargetDir)/$(RustLibName)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Salin File Shared Library saat dotnet publish ke Root Output (/app/publish) -->
  <Target Name="CopyRustFFIToPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Include="../axum/target/$(RustTargetDir)/$(RustLibName)">
        <RelativePath>$(RustLibName)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>