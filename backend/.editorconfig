# Meta-configuration
root = true

# Semua File C# (.cs)
[*.cs]

# ==============================================================================
# 1. ATURAN INDENTASI & INDENT (Mirip Prettier / ESLint)
# ==============================================================================
indent_style = space
indent_size = 4
tab_width = 4
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# ==============================================================================
# 2. FORMATTING LINGKUNGAN C# (Dapat Di-fix Otomatis via dotnet format / Save)
# ==============================================================================

# Spasi & Baris Baru
csharp_new_line_before_open_brace = all
csharp_space_after_cast = false
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_parentheses = false

# Pengorganisasian Directives ('using')
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:warning

# Namespace (Gunakan File-Scoped Namespace khas .NET 6+)
csharp_style_namespace_declarations = file_scoped:warning

# ==============================================================================
# 3. ATURAN PENULISAN KODE (CODE STYLE)
# ==============================================================================

# Penggunaan 'var' (Gunakan var saat tipe data eksplisit/jelas)
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

# Fitur C# Modern
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_constructors = false:silent
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_pattern_matching_over_as_with_null_check = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion

# 'this.' qualifier (Hapus 'this.' jika tidak diperlukan)
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion

# Parentheses & Type Modifiers
dotnet_style_parentheses_in_arithmetic_binary_operators = never_if_unnecessary:suggestion
csharp_preferred_modifier_order = public,private,protected,internal,file,static,abstract,virtual,sealed,readonly,override,asynchronous,unsafe,volatile:warning

# ==============================================================================
# 4. SUPPRESSION / PENONAKTIFAN BISING (StyleCop, Roslynator, CA, IDE & ASP)
# ==============================================================================

# StyleCop: XML Documentation Header & Element Ordering (Tanpa Fix All)
dotnet_diagnostic.SA1600.severity = none
dotnet_diagnostic.SA1601.severity = none
dotnet_diagnostic.SA1602.severity = none
dotnet_diagnostic.SA1611.severity = none
dotnet_diagnostic.SA1618.severity = none
dotnet_diagnostic.SA1633.severity = none
dotnet_diagnostic.SA1649.severity = none
dotnet_diagnostic.SA1200.severity = none
dotnet_diagnostic.SA1201.severity = none
dotnet_diagnostic.SA1202.severity = none
dotnet_diagnostic.SA1204.severity = none
dotnet_diagnostic.SA1214.severity = none
dotnet_diagnostic.SA1117.severity = none
dotnet_diagnostic.SA1402.severity = none

# Unused Parameters & Variable Rules (Sering Memicu Error di CLI)
dotnet_diagnostic.IDE0060.severity = none
dotnet_diagnostic.RCS1163.severity = none

# Roslynator Rules Tanpa Fix All Massal (Ubah jadi none / suggestion)
dotnet_diagnostic.RCS1073.severity = suggestion
dotnet_diagnostic.RCS1093.severity = none
dotnet_diagnostic.RCS1110.severity = none
dotnet_diagnostic.RCS1112.severity = suggestion
dotnet_diagnostic.RCS1158.severity = suggestion
dotnet_diagnostic.RCS1235.severity = suggestion
dotnet_diagnostic.RCS1246.severity = suggestion

# Code Analysis (CA) & ASP.NET Core Rules
dotnet_diagnostic.CA1050.severity = none
dotnet_diagnostic.CA1806.severity = suggestion
dotnet_diagnostic.CA1826.severity = suggestion
dotnet_diagnostic.CA1848.severity = suggestion
dotnet_diagnostic.ASP0015.severity = suggestion
dotnet_diagnostic.ASP0025.severity = suggestion
