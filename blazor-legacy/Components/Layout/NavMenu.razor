</header>

<AuthorizeView>
    <Authorized>
        <!-- STATUS STRIP -->
        <div class="status-strip px-3 py-1 d-flex justify-content-center align-items-center gap-3 text-nowrap" style="min-height: 30px; font-size: 0.75rem;">
            <div class="dropdown">
                <button class="btn btn-sm btn-link text-decoration-none p-0 fw-medium d-flex align-items-center gap-2 dropdown-toggle shadow-none status-badge" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi @iconClass"></i>
                    <span class="text-body fw-semibold @(!hasActivePeriod ? "text-danger" : "")">@periodText</span>
                    @if (isViewingClosed)
                    {
                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle font-monospace" style="font-size: 0.65rem;">LOCKED</span>
                    }
                </button>
                
                <ul class="dropdown-menu shadow-lg border-secondary border-opacity-25 mt-1" style="font-size: 0.75rem; min-width: 190px;">
                    <li><h6 class="dropdown-header py-1 text-uppercase" style="font-size: 0.65rem;">Accounting Period</h6></li>
                    <li>
                        <NavLink class="dropdown-item py-1 text-primary fw-semibold d-flex align-items-center gap-2" href="/periods/create">
                            <i class="bi bi-plus-circle"></i> Open New Period
                        </NavLink>
                    </li>
                    <li><hr class="dropdown-divider my-1"></li>
                    <li>
                        <NavLink class="dropdown-item py-1 d-flex align-items-center gap-2" href="/periods">
                            <i class="bi bi-list-ul"></i> Manage All Periods
                        </NavLink>
                    </li>
                    @if (hasActivePeriod)
                    {
                        <li>
                            <NavLink class="dropdown-item py-1 text-danger d-flex align-items-center gap-2" href="/periods/clear-selection">
                                <i class="bi bi-eye-slash"></i> Stop Viewing
                            </NavLink>
                        </li>
                    }
                </ul>
            </div>

            <span class="text-secondary opacity-25">|</span>

            <div class="d-flex align-items-center gap-2 fs-8 font-monospace">
                <button class="btn btn-sm btn-link text-success p-0 border-0 shadow-none lh-1 d-flex align-items-center gap-1" type="button" title="Guardian Security: Protected & Active" aria-label="Guardian Status">
                    <span class="pulse-dot-green me-1"></span>
                    <i class="bi bi-shield-check" style="font-size: 0.825rem;"></i>
                    <span class="d-none d-sm-inline text-muted" style="font-size: 0.7rem;">PROTECTED</span>
                </button>

                <span class="text-secondary opacity-25">/</span>

                <button id="syncBtn" class="btn btn-sm btn-link text-info p-0 border-0 shadow-none lh-1 d-flex align-items-center gap-1" type="button" title="Sync: Up to date" aria-label="Sync Status">
                    <i id="syncIcon" class="bi bi-cloud-check" style="font-size: 0.825rem;"></i>
                    <span class="d-none d-sm-inline text-muted" style="font-size: 0.7rem;">SYNCED</span>
                </button>
            </div>
        </div>

        <!-- SEARCH MODAL -->
        <div class="modal fade" id="searchModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-top modal-md mt-5">
                <div class="modal-content topbar-solid border border-secondary border-opacity-25 shadow-lg">
                    <div class="modal-body p-3">
                        <div class="input-group">
                            <span class="input-group-text bg-transparent border-0 text-warning"><i class="bi bi-search"></i></span>
                            <input type="search" class="form-control bg-transparent border-0 shadow-none text-body" placeholder="Type a command or search accounts, entries..." autofocus>
                            <button type="button" class="btn-close btn-close-white ms-2 my-auto" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- SIDEBAR DOCK -->
        <div class="sidebar-wrapper d-flex sidebar-sticky-neon">
            
            <!-- MAIN ICON DOCK -->
            <nav id="sidebar-icons" class="sidebar-icons text-white d-flex flex-column align-items-center py-3">

                <!-- BRAND / HOME ICON -->
                <NavLink href="/" Match="NavLinkMatch.All" class="brand-container text-center text-warning text-decoration-none mb-2" title="Aumo Finance Home" @onclick="CloseFlyout">
                    <i class="bi bi-house-door-fill fs-5"></i>
                </NavLink>

                <!-- GLOWING WHITE DIVIDER -->
                <hr class="hr-glow-white my-2 w-75">

                <!-- MENU NAVIGATION LIST -->
                <ul class="nav flex-column align-items-center w-100 flex-grow-1">

                    <li class="nav-item mb-2">
                        <NavLink href="/dashboard" class="nav-link icon-btn" title="Dashboard" @onclick="CloseFlyout">
                            <i class="bi bi-columns-gap fs-5"></i>
                        </NavLink>
                    </li>

                    <!-- MENU AI ASSISTANT -->
                    <li class="nav-item mb-2">
                        <NavLink href="/ai-assistant" class="nav-link icon-btn" title="AI Financial Assistant" @onclick="CloseFlyout">
                            <i class="bi bi-robot fs-5"></i>
                        </NavLink>
                    </li>

                    <li class="nav-item mb-2">
                        <NavLink href="/journal-entry/create" class="nav-link icon-btn" title="Journal Entry" @onclick="CloseFlyout">
                            <i class="bi bi-journal-plus fs-5"></i>
                        </NavLink>
                    </li>

                    <!-- MENU REPORTS (TOGGLE FLYOUT) -->
                    <li class="nav-item mb-2">
                        <button type="button" 
                                @onclick="ToggleReportsFlyout" 
                                class="nav-link icon-btn border-0 bg-transparent @(showReportsFlyout ? "active" : "")" 
                                title="Reports">
                            <i class="bi bi-folder fs-5"></i>
                        </button>
                    </li>

                    <li class="nav-item mb-2">
                        <NavLink href="/chart-of-accounts" class="nav-link icon-btn" title="Chart of Accounts" @onclick="CloseFlyout">
                            <i class="bi bi-diagram-3 fs-5"></i>
                        </NavLink>
                    </li>

                    <li class="nav-item mb-2">
                        <NavLink href="/periods" class="nav-link icon-btn" title="Financial Periods" @onclick="CloseFlyout">
                            <i class="bi bi-calendar3 fs-5"></i>
                        </NavLink>
                    </li>

                    <!-- MENU DOCUMENTS -->
                    <li class="nav-item mb-2">
                        <NavLink href="/documents" class="nav-link icon-btn" title="Economic Documents" @onclick="CloseFlyout">
                            <i class="bi bi-file-earmark-text fs-5"></i>
                        </NavLink>
                    </li>

                    <li class="nav-item mb-2">
                        <NavLink href="/guardian" class="nav-link icon-btn" title="Guardian Security" @onclick="CloseFlyout">
                            <i class="bi bi-shield-check fs-5"></i>
                        </NavLink>
                    </li>

                    <li class="nav-item mb-2">
                        <NavLink href="/tools" class="nav-link icon-btn" title="Tools" @onclick="CloseFlyout">
                            <i class="bi bi-tools fs-5"></i>
                        </NavLink>
                    </li>

                </ul>

                <!-- AUTH MENU & PROFILE DROPDOWN WITH STATUS LED -->
                <div class="mt-auto dropup position-relative">
                    <button class="nav-link icon-btn border-0 bg-transparent" 
                            id="userDropdown" 
                            data-bs-toggle="dropdown" 
                            aria-expanded="false" 
                            title="@(context.User.Identity?.Name ?? "User Profile")">
                        <i class="bi bi-person-circle fs-5"></i>
                    </button>
                    <!-- Status LED Micro Glow -->
                    <span class="position-absolute bottom-0 end-0 p-1 bg-success border border-dark rounded-circle" style="width: 7px; height: 7px; box-shadow: 0 0 6px #10b981;"></span>

                    <ul class="dropdown-menu dropdown-menu-dark shadow ms-2 mb-2 fs-7" aria-labelledby="userDropdown">
                        <li class="dropdown-header text-truncate" style="max-width: 180px;">
                            @(context.User.Identity?.Name ?? "User")
                        </li>

                        <li><hr class="dropdown-divider"></li>

                        <li>
                            <NavLink class="dropdown-item d-flex align-items-center" href="/settings" @onclick="CloseFlyout">
                                <i class="bi bi-gear me-2"></i> Settings
                            </NavLink>
                        </li>

                        <li>
                            <button type="button" @onclick="HandleSignOutAsync" class="dropdown-item d-flex align-items-center text-danger border-0 bg-transparent w-100">
                                <i class="bi bi-box-arrow-right me-2"></i> Sign Out
                            </button>
                        </li>
                    </ul>
                </div>

            </nav>

            <!-- HOLOGRAM FLYOUT PANEL (REPORTS) -->
            @if (showReportsFlyout)
            {
                <div id="reports-flyout" class="sidebar-flyout">

                    <div class="p-3 border-bottom border-secondary border-opacity-25 d-flex justify-content-end align-items-center">
                        <button type="button" @onclick="CloseFlyout" class="btn-close btn-close-white btn-sm" aria-label="Close"></button>
                    </div>

                    <div class="list-group list-group-flush p-2 small">

                        <NavLink href="/reports/general-journal" class="list-group-item list-group-item-action py-2 px-3 rounded mb-1" @onclick="CloseFlyout">
                            General Journal
                        </NavLink>

                        <NavLink href="/reports/general-ledger" Match="NavLinkMatch.All" class="list-group-item list-group-item-action py-2 px-3 rounded mb-1" @onclick="CloseFlyout">
                            GL (Permanent Accounts)
                        </NavLink>

                        <NavLink href="/reports/general-ledger/true" class="list-group-item list-group-item-action py-2 px-3 rounded mb-1" @onclick="CloseFlyout">
                            GL (Temporary Accounts)
                        </NavLink>

                        <NavLink href="/reports/trial-balance" Match="NavLinkMatch.All" class="list-group-item list-group-item-action py-2 px-3 rounded mb-1" @onclick="CloseFlyout">
                            Trial Balance
                        </NavLink>

                        <NavLink href="/reports/adjusting-journal" class="list-group-item list-group-item-action py-2 px-3 rounded mb-1" @onclick="CloseFlyout">
                            Adjusting Journal
                        </NavLink>

                        <NavLink href="/reports/trial-balance/true" class="list-group-item list-group-item-action py-2 px-3 rounded mb-1" @onclick="CloseFlyout">
                            Adjusted Trial Balance
                        </NavLink>

                        <NavLink href="/reports/worksheet" class="list-group-item list-group-item-action py-2 px-3 rounded mb-1" @onclick="CloseFlyout">
                            Worksheet
                        </NavLink>

                        <NavLink href="/reports/income-statement" class="list-group-item list-group-item-action py-2 px-3 rounded mb-1" @onclick="CloseFlyout">
                            Income Statement
                        </NavLink>

                        <NavLink href="/reports/retained-earnings" class="list-group-item list-group-item-action py-2 px-3 rounded mb-1" @onclick="CloseFlyout">
                            Retained Earnings
                        </NavLink>

                        <NavLink href="/reports/statement-of-financial-position" class="list-group-item list-group-item-action py-2 px-3 rounded mb-1" @onclick="CloseFlyout">
                            Financial Position
                        </NavLink>

                        <NavLink href="/reports/closing-journal" class="list-group-item list-group-item-action py-2 px-3 rounded mb-1" @onclick="CloseFlyout">
                            Closing Journal
                        </NavLink>

                        <NavLink href="/reports/post-closing-trial-balance" class="list-group-item list-group-item-action py-2 px-3 rounded mb-1" @onclick="CloseFlyout">
                            Post-Closing TB
                        </NavLink>

                        <NavLink href="/reports/cash-flow" class="list-group-item list-group-item-action py-2 px-3 rounded mb-1" @onclick="CloseFlyout">
                            Cash Flow
                        </NavLink>

                    </div>
                </div>
            }

        </div>
    </Authorized>
</AuthorizeView>

@code {
    private string? activePeriodName;
    private bool hasActivePeriod;
    private bool isViewingClosed;
    private string periodText = "No Period Selected";
    private string iconClass = "bi-calendar-x text-warning";
    private bool showReportsFlyout = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            var currentUserIdStr = user.FindFirstValue(ClaimTypes.NameIdentifier);
            if (Guid.TryParse(currentUserIdStr, out var currentUserId))
            {
                await using var context = await DbFactory.CreateDbContextAsync();
                var activePeriodObj = await context.Periods
                    .FirstOrDefaultAsync(p => p.UserId == currentUserId && p.IsSelected);

                if (activePeriodObj != null)
                {
                    activePeriodName = activePeriodObj.PeriodName;
                    hasActivePeriod = !string.IsNullOrEmpty(activePeriodName);
                    isViewingClosed = activePeriodObj.IsClosed;
                    periodText = hasActivePeriod ? activePeriodName : "No Period Selected";
                    iconClass = !hasActivePeriod
                        ? "bi-calendar-x text-warning"
                        : (isViewingClosed ? "bi-lock-fill text-secondary" : "bi-calendar2-check text-success");
                }
            }
        }
    }

    private void ToggleReportsFlyout()
    {
        showReportsFlyout = !showReportsFlyout;
    }

    private void CloseFlyout()
    {
        showReportsFlyout = false;
    }

    private async Task HandleSignOutAsync()
    {
        CloseFlyout();
        try
        {
            await Http.PostAsync("api/v1/auth/logout", null);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to call logout API.");
        }
        finally
        {
            Navigation.NavigateTo("/auth/login", forceLoad: true);
        }
    }
}

<style>
    /* STICKY CONTAINER UTAMA */
    .sidebar-sticky-neon {
        position: -webkit-sticky;
        position: sticky;
        top: 0;
        height: 100vh;
        max-height: 100vh;
        align-self: flex-start;
        z-index: 1030;
        flex-shrink: 0;
    }

    /* KOTAK DOCK UNGU DENGAN FULL WHITE NEON BORDER (360 DERAJAT) */
    .sidebar-icons {
        width: 65px;
        height: 100vh;
        background-color: #1a1625;
        border: 2px solid #ffffff;
        border-radius: 8px;
        box-shadow: 
            0 0 5px #ffffff,
            0 0 15px #ffffff,
            0 0 30px #ffffff;
    }

    /* HOLOGRAM FLYOUT PANEL WITH MATCHING NEON BORDER */
    .sidebar-flyout {
        width: 230px;
        height: 100vh;
        overflow-y: auto;
        background-color: rgba(26, 22, 37, 0.95);
        backdrop-filter: blur(8px);
        margin-left: 6px;
        border: 2px solid #ffffff;
        border-radius: 8px;
        box-shadow: 
            0 0 5px #ffffff,
            0 0 12px rgba(255, 255, 255, 0.6);
    }

    /* TOMBOL IKON NAVIGASI */
    .icon-btn {
        color: #b3a5d0;
        padding: 0.5rem;
        border-radius: 0.375rem;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease-in-out;
    }

    .icon-btn:hover, 
    .icon-btn.active {
        color: #ffffff;
        background-color: rgba(255, 255, 255, 0.15);
        box-shadow: 0 0 10px rgba(255, 255, 255, 0.6);
    }

    /* DIVIDER NEON PUTIH DI DALAM KOTAK */
    .hr-glow-white {
        border: none !important;
        height: 1px !important;
        background-color: #ffffff !important;
        opacity: 0.9 !important;
        box-shadow: 0 0 6px #ffffff, 0 0 12px rgba(255, 255, 255, 0.5) !important;
    }

    /* FLYOUT ITEM LINK */
    .sidebar-flyout .list-group-item {
        background-color: transparent;
        color: #d8ceee;
        border: none;
        transition: background-color 0.2s ease, color 0.2s ease;
    }

    .sidebar-flyout .list-group-item:hover,
    .sidebar-flyout .list-group-item.active {
        background-color: rgba(255, 255, 255, 0.15);
        color: #ffffff;
    }
</style>
