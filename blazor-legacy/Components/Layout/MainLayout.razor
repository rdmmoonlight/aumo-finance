@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization

<div class="d-flex flex-column min-vh-100 min-vw-0 aumo-main-shell">

    <!-- TOPBAR (Di Paling Atas) -->
    <AuthorizeView>
        <Authorized>
            <AumoBlazor.Components.Layout.TopBar />
        </Authorized>
    </AuthorizeView>

    <!-- CONTAINER UTAMA (flex-nowrap mencegah main terdorong ke bawah) -->
    <div class="d-flex flex-row flex-nowrap flex-grow-1 w-100 position-relative align-items-stretch">
        
        <!-- SIDEBAR (Kiri) -->
        <AuthorizeView>
            <Authorized>
                <AumoBlazor.Components.Layout.Sidebar />
            </Authorized>
        </AuthorizeView>

        <!-- MAIN CONTENT (Kanan) -->
        <main id="mainContent" class="content flex-grow-1 p-2 p-md-4 d-flex flex-column" role="main">
            @Body
        </main>

    </div>

</div>

<style>
    body {
        transition: background-color 0.3s ease, color 0.3s ease;
        overflow-x: hidden;
    }

    .aumo-main-shell {
        background-color: var(--aumo-bg, #0D1117);
        color: var(--aumo-text, #FFFFFF);
    }

    /* PENTING: Mencegah konten meluap dan memaksa tetap di samping Sidebar */
    .content { 
        transition: background-color 0.3s ease;
        min-width: 0; 
        width: 100%;
    }

    @@media (max-width: 767.98px) {
        #mainContent {
            padding: 0.75rem 0.5rem !important;
        }
    }
</style>
