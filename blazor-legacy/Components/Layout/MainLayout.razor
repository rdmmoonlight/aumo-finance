@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization

<div class="aumo-main-shell min-vh-100 min-vw-0 d-flex flex-column">

    <!-- 1. TOPBAR (Membentang Penuh 100% di Atas) -->
    <div class="topbar-container flex-shrink-0 w-100">
        <AuthorizeView>
            <Authorized>
                <AumoBlazor.Components.Layout.AppTopBar />
            </Authorized>
        </AuthorizeView>
    </div>

    <!-- 2. SHELL UTAMA (Mengunci NavMenu & Main Content Agar Sejajar Menyamping) -->
    <div class="aumo-body-shell flex-grow-1 d-flex flex-row flex-nowrap w-100 align-items-stretch position-relative">
        
        <!-- SIDEBAR / NAVMENU (Kiri) -->
        <div class="sidebar-container flex-shrink-0">
            <AuthorizeView>
                <Authorized>
                    <AumoBlazor.Components.Layout.NavMenu />
                </Authorized>
            </AuthorizeView>
        </div>

        <!-- MAIN CONTENT AREA (Kanan - Mengisi Sisa Ruang) -->
        <main id="mainContent" class="content flex-grow-1 p-2 p-md-4 d-flex flex-column" role="main">
            @Body
        </main>

    </div>

</div>
