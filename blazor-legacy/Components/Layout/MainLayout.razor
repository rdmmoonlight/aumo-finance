@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization

<!-- ==========================================
     Aumo Finance - Main Layout
     Cosmic / Nebula Theme
     ========================================== -->

<div class="d-flex flex-column min-vh-100 min-vw-0 aumo-main-shell">

    <!-- SHELL UTAMA -->
    <div class="d-flex flex-grow-1 position-relative">
        
        <!-- NAVIGATION MENU (Sidebar / Header Nav) -->
        <AuthorizeView>
            <Authorized>
                <AumoBlazor.Components.Layout.NavMenu />
            </Authorized>
        </AuthorizeView>

        <!-- MAIN CONTENT AREA -->
        <main id="mainContent" class="content flex-grow-1 p-2 p-md-4 d-flex flex-column" role="main">
            @Body
        </main>

    </div>

</div>

<style>
    body {
        transition: background-color 0.3s ease, color 0.3s ease;
    }

    .content { 
        transition: background-color 0.3s ease;
    }

    @@media (max-width: 767.98px) {
        #mainContent {
            padding: 0.75rem 0.5rem !important;
        }
    }
</style>
