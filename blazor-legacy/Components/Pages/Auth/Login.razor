@page "/auth/login"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization

@attribute [AllowAnonymous]

<PageTitle>Sign In - Aumo Finance</PageTitle>

<div class="d-flex align-items-center justify-content-center min-vh-100 w-100 py-5" style="background-color: var(--aumo-bg, #0D1117);">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-5 text-start">
                
                <!-- Card Container -->
                <div class="card border rounded-4 p-4 p-md-5 shadow-lg" 
                     style="background-color: var(--aumo-surface, #161B22); border-color: var(--bs-border-color, #2A313C) !important;">
                    <div class="card-body p-0">
                        
                        <!-- Icon Badge -->
                        <div class="text-center mb-3">
                            <div class="d-inline-block p-3 rounded-circle" style="background-color: rgba(59, 130, 246, 0.15); color: var(--aumo-primary, #3B82F6);">
                                <i class="bi bi-shield-lock-fill display-5 lh-1"></i>
                            </div>
                        </div>

                        <!-- Title & Subtitle -->
                        <div class="text-center mb-4">
                            <h2 class="fw-bold mb-1 tracking-tight" style="color: var(--aumo-text, #FFFFFF);">
                                Sign In
                            </h2>
                            <p class="small mb-0" style="color: var(--aumo-text-muted, #FFFFFF);">
                                Access your financial dashboard
                            </p>
                        </div>

                        <!-- Alert Messages (via Query Parameters) -->
                        @if (!string.IsNullOrEmpty(successMessage))
                        {
                            <div class="alert alert-success py-2 px-3 small rounded-3 mb-3" role="alert">
                                <i class="bi bi-check-circle-fill me-2"></i>@successMessage
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger py-2 px-3 small rounded-3 mb-3" role="alert">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(infoMessage))
                        {
                            <div class="alert alert-info py-2 px-3 small rounded-3 mb-3" role="alert">
                                <i class="bi bi-info-circle-fill me-2"></i>@infoMessage
                            </div>
                        }

                        <!-- Native Form POST ke API Backend -->
                        <form action="https://aumonext-api.onrender.com/api/v1/auth/login" method="post">
                            <input type="hidden" name="ReturnUrl" value="/" />
                            
                            <!-- Email Input -->
                            <div class="mb-3">
                                <label class="form-label small fw-medium" style="color: var(--aumo-text-muted, #FFFFFF);">Email Address</label>
                                <div class="input-group">
                                    <span class="input-group-text border-end-0" style="background-color: var(--aumo-bg, #0D1117); border-color: var(--bs-border-color, #2A313C); color: var(--aumo-text-muted, #FFFFFF);">
                                        <i class="bi bi-envelope"></i>
                                    </span>
                                    <input type="email" 
                                           name="Email" 
                                           required 
                                           class="form-control border-start-0 ps-0 text-white" 
                                           style="background-color: var(--aumo-bg, #0D1117); border-color: var(--bs-border-color, #2A313C);" 
                                           autocomplete="username"
                                           placeholder="name@example.com" />
                                </div>
                            </div>

                            <!-- Password Input -->
                            <div class="mb-3">
                                <label class="form-label small fw-medium" style="color: var(--aumo-text-muted, #FFFFFF);">Password</label>
                                <div class="input-group">
                                    <span class="input-group-text border-end-0" style="background-color: var(--aumo-bg, #0D1117); border-color: var(--bs-border-color, #2A313C); color: var(--aumo-text-muted, #FFFFFF);">
                                        <i class="bi bi-lock"></i>
                                    </span>
                                    <input type="password" 
                                           name="Password" 
                                           required 
                                           class="form-control border-start-0 ps-0 text-white" 
                                           style="background-color: var(--aumo-bg, #0D1117); border-color: var(--bs-border-color, #2A313C);" 
                                           autocomplete="current-password"
                                           placeholder="••••••••" />
                                </div>
                            </div>

                            <!-- Remember Me -->
                            <div class="mb-4 form-check">
                                <input type="checkbox" name="RememberMe" id="rememberMe" value="true" class="form-check-input" />
                                <label class="form-check-label small" for="rememberMe" style="color: var(--aumo-text-muted, #FFFFFF);">
                                    Remember me
                                </label>
                            </div>

                            <!-- Submit Button -->
                            <button type="submit" class="btn btn-primary w-100 py-2.5 rounded-pill fw-medium shadow-sm d-flex align-items-center justify-content-center gap-2">
                                <span>Sign In</span>
                                <i class="bi bi-arrow-right-short fs-5"></i>
                            </button>
                        </form>

                        <!-- Links -->
                        <div class="mt-4 pt-3 text-center border-top" style="border-color: var(--bs-border-color, #2A313C) !important;">
                            <a href="/auth/resend-verification" class="text-decoration-none small" style="color: var(--aumo-text-muted, #FFFFFF);">
                                Didn't receive verification email?
                            </a>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "message")]
    private string? QueryMessage { get; set; }

    [SupplyParameterFromQuery(Name = "successMessage")]
    private string? QuerySuccessMessage { get; set; }

    [SupplyParameterFromQuery(Name = "errorMessage")]
    private string? QueryErrorMessage { get; set; }

    [SupplyParameterFromQuery(Name = "infoMessage")]
    private string? QueryInfoMessage { get; set; }

    private string? successMessage;
    private string? errorMessage;
    private string? infoMessage;

    protected override void OnInitialized()
    {
        successMessage = QuerySuccessMessage ?? QueryMessage;
        errorMessage = QueryErrorMessage;
        infoMessage = QueryInfoMessage;
    }
}
