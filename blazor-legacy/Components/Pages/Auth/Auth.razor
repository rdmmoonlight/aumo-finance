@page "/auth/login"
@page "/auth/register"
@page "/auth/resend-verification"
@page "/auth/verify-email"

@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@using System.Text
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.WebUtilities

@attribute [AllowAnonymous]
@rendermode InteractiveServer

@inject HttpClient Http
@inject NavigationManager Navigation
@inject ILogger<Auth> Logger

<PageTitle>@GetPageTitle() - Aumo Finance</PageTitle>

<div class="d-flex align-items-center justify-content-center min-vh-100 w-100 py-5" style="background-color: var(--aumo-bg, #0D1117);">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-5 text-start">
                
                <!-- Card Container -->
                <div class="card border rounded-4 p-4 p-md-5 shadow-lg" 
                     style="background-color: var(--aumo-surface, #161B22); border-color: var(--bs-border-color, #2A313C) !important;">
                    <div class="card-body p-0">
                        
                        <!-- Icon Badge -->
                        <div class="text-center mb-3">
                            <div class="d-inline-block p-3 rounded-circle" style="background-color: rgba(59, 130, 246, 0.15); color: var(--aumo-primary, #3B82F6);">
                                <i class="bi @GetPageIcon() display-5 lh-1"></i>
                            </div>
                        </div>

                        <!-- Title & Subtitle -->
                        <div class="text-center mb-4">
                            <h2 class="fw-bold mb-1 tracking-tight" style="color: var(--aumo-text, #FFFFFF);">
                                @GetPageTitle()
                            </h2>
                            <p class="small mb-0" style="color: var(--aumo-text-muted, #FFFFFF);">
                                @GetPageSubtitle()
                            </p>
                        </div>

                        <!-- Alert Messages -->
                        @if (!string.IsNullOrEmpty(successMessage))
                        {
                            <div class="alert alert-success py-2 px-3 small rounded-3 mb-3" role="alert">
                                <i class="bi bi-check-circle-fill me-2"></i>@((MarkupString)successMessage)
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger py-2 px-3 small rounded-3 mb-3" role="alert">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>@((MarkupString)errorMessage)
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(infoMessage))
                        {
                            <div class="alert alert-info py-2 px-3 small rounded-3 mb-3" role="alert">
                                <i class="bi bi-info-circle-fill me-2"></i>@((MarkupString)infoMessage)
                            </div>
                        }

                        @* ==================== 1. TAMPILAN LOGIN ==================== *@
                        @if (IsRoute("/auth/login"))
                        {
                            <EditForm Model="LoginInput" OnValidSubmit="HandleLoginAsync" FormName="LoginForm">
                                <DataAnnotationsValidator />
                                <ValidationSummary class="text-danger small mb-3" />

                                <div class="mb-3">
                                    <label class="form-label small fw-medium" style="color: var(--aumo-text-muted, #FFFFFF);">Email Address</label>
                                    <div class="input-group">
                                        <span class="input-group-text border-end-0" style="background-color: var(--aumo-bg, #0D1117); border-color: var(--bs-border-color, #2A313C); color: var(--aumo-text-muted, #FFFFFF);">
                                            <i class="bi bi-envelope"></i>
                                        </span>
                                        <InputText class="form-control border-start-0 ps-0 text-white" 
                                                   style="background-color: var(--aumo-bg, #0D1117); border-color: var(--bs-border-color, #2A313C);" 
                                                   @bind-Value="LoginInput!.Email" 
                                                   autocomplete="username"
                                                   placeholder="name@example.com" />
                                    </div>
                                    <ValidationMessage For="() => LoginInput!.Email" class="text-danger small mt-1" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label small fw-medium" style="color: var(--aumo-text-muted, #FFFFFF);">Password</label>
                                    <div class="input-group">
                                        <span class="input-group-text border-end-0" style="background-color: var(--aumo-bg, #0D1117); border-color: var(--bs-border-color, #2A313C); color: var(--aumo-text-muted, #FFFFFF);">
                                            <i class="bi bi-lock"></i>
                                        </span>
                                        <InputText type="password" 
                                                   class="form-control border-start-0 ps-0 text-white" 
                                                   style="background-color: var(--aumo-bg, #0D1117); border-color: var(--bs-border-color, #2A313C);" 
                                                   @bind-Value="LoginInput!.Password" 
                                                   autocomplete="current-password"
                                                   placeholder="••••••••" />
                                    </div>
                                    <ValidationMessage For="() => LoginInput!.Password" class="text-danger small mt-1" />
                                </div>

                                <div class="mb-4 form-check">
                                    <InputCheckbox id="rememberMe" class="form-check-input" @bind-Value="LoginInput!.RememberMe" />
                                    <label class="form-check-label small" for="rememberMe" style="color: var(--aumo-text-muted, #FFFFFF);">
                                        Remember me
                                    </label>
                                </div>

                                <button type="submit" disabled="@isSubmitting" class="btn btn-primary w-100 py-2.5 rounded-pill fw-medium shadow-sm d-flex align-items-center justify-content-center gap-2">
                                    @if (isSubmitting)
                                    {
                                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                        <span>Signing In...</span>
                                    }
                                    else
                                    {
                                        <span>Sign In</span>
                                        <i class="bi bi-arrow-right-short fs-5"></i>
                                    }
                                </button>
                            </EditForm>

                            <div class="mt-4 pt-3 text-center border-top d-flex flex-column gap-2" style="border-color: var(--bs-border-color, #2A313C) !important;">
                                <a href="/auth/register" class="text-decoration-none small text-primary">
                                    Don't have an account? Create one
                                </a>
                                <a href="/auth/resend-verification" class="text-decoration-none small" style="color: var(--aumo-text-muted, #FFFFFF);">
                                    Didn't receive verification email?
                                </a>
                            </div>
                        }

                        @* ==================== 2. TAMPILAN REGISTER ==================== *@
                        else if (IsRoute("/auth/register"))
                        {
                            <EditForm Model="RegisterInput" OnValidSubmit="HandleRegisterAsync" FormName="RegisterForm">
                                <DataAnnotationsValidator />
                                <ValidationSummary class="text-danger small mb-3" />

                                <div class="mb-3">
                                    <label class="form-label small fw-medium" style="color: var(--aumo-text-muted, #FFFFFF);">Full Name</label>
                                    <InputText class="form-control text-white" 
                                               style="background-color: var(--aumo-bg, #0D1117); border-color: var(--bs-border-color, #2A313C);" 
                                               @bind-Value="RegisterInput!.FullName" 
                                               placeholder="John Doe" />
                                    <ValidationMessage For="() => RegisterInput!.FullName" class="text-danger small mt-1" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label small fw-medium" style="color: var(--aumo-text-muted, #FFFFFF);">Email Address</label>
                                    <InputText class="form-control text-white" 
                                               style="background-color: var(--aumo-bg, #0D1117); border-color: var(--bs-border-color, #2A313C);" 
                                               @bind-Value="RegisterInput!.Email" 
                                               placeholder="name@example.com" />
                                    <ValidationMessage For="() => RegisterInput!.Email" class="text-danger small mt-1" />
                                </div>

                                <div class="mb-4">
                                    <label class="form-label small fw-medium" style="color: var(--aumo-text-muted, #FFFFFF);">Password</label>
                                    <InputText type="password" 
                                               class="form-control text-white" 
                                               style="background-color: var(--aumo-bg, #0D1117); border-color: var(--bs-border-color, #2A313C);" 
                                               @bind-Value="RegisterInput!.Password" 
                                               placeholder="••••••••" />
                                    <ValidationMessage For="() => RegisterInput!.Password" class="text-danger small mt-1" />
                                </div>

                                <button type="submit" disabled="@isSubmitting" class="btn btn-primary w-100 py-2.5 rounded-pill fw-medium shadow-sm d-flex align-items-center justify-content-center gap-2">
                                    @if (isSubmitting)
                                    {
                                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                        <span>Creating Account...</span>
                                    }
                                    else
                                    {
                                        <span>Register Account</span>
                                        <i class="bi bi-person-plus-fill fs-6"></i>
                                    }
                                </button>
                            </EditForm>

                            <div class="mt-4 pt-3 text-center border-top" style="border-color: var(--bs-border-color, #2A313C) !important;">
                                <a href="/auth/login" class="text-decoration-none small text-primary">
                                    Already have an account? Sign In
                                </a>
                            </div>
                        }

                        @* ==================== 3. TAMPILAN RESEND VERIFICATION ==================== *@
                        else if (IsRoute("/auth/resend-verification"))
                        {
                            <EditForm Model="ResendInput" OnValidSubmit="HandleResendAsync" FormName="ResendForm">
                                <DataAnnotationsValidator />
                                <ValidationSummary class="text-danger small mb-3" />

                                <div class="mb-4">
                                    <label class="form-label small fw-medium" style="color: var(--aumo-text-muted, #FFFFFF);">Email Address</label>
                                    <InputText class="form-control text-white" 
                                               style="background-color: var(--aumo-bg, #0D1117); border-color: var(--bs-border-color, #2A313C);" 
                                               @bind-Value="ResendInput!.Email" 
                                               placeholder="name@example.com" />
                                    <ValidationMessage For="() => ResendInput!.Email" class="text-danger small mt-1" />
                                </div>

                                <button type="submit" disabled="@isSubmitting" class="btn btn-primary w-100 py-2.5 rounded-pill fw-medium shadow-sm d-flex align-items-center justify-content-center gap-2">
                                    @if (isSubmitting)
                                    {
                                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                        <span>Sending Email...</span>
                                    }
                                    else
                                    {
                                        <span>Send Verification Link</span>
                                        <i class="bi bi-send-fill fs-6"></i>
                                    }
                                </button>
                            </EditForm>

                            <div class="mt-4 pt-3 text-center border-top" style="border-color: var(--bs-border-color, #2A313C) !important;">
                                <a href="/auth/login" class="text-decoration-none small text-primary">
                                    Back to Sign In
                                </a>
                            </div>
                        }

                        @* ==================== 4. TAMPILAN VERIFY EMAIL ==================== *@
                        else if (IsRoute("/auth/verify-email"))
                        {
                            <div class="text-center py-4">
                                @if (isSubmitting)
                                {
                                    <div class="spinner-border text-primary mb-3" role="status">
                                        <span class="visually-hidden">Loading...</span>
                                    </div>
                                    <p class="small text-white">Verifying your email address, please wait...</p>
                                }
                                else
                                {
                                    <a href="/auth/login" class="btn btn-outline-primary rounded-pill px-4 btn-sm">
                                        Proceed to Login
                                    </a>
                                }
                            </div>
                        }

                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "message")]
    private string? QueryMessage { get; set; }

    [SupplyParameterFromQuery(Name = "successMessage")]
    private string? QuerySuccessMessage { get; set; }

    [SupplyParameterFromQuery(Name = "errorMessage")]
    private string? QueryErrorMessage { get; set; }

    [SupplyParameterFromQuery(Name = "infoMessage")]
    private string? QueryInfoMessage { get; set; }

    [SupplyParameterFromQuery(Name = "email")]
    private string? QueryEmail { get; set; }

    [SupplyParameterFromQuery(Name = "token")]
    private string? QueryToken { get; set; }

    // Input Models
    [SupplyParameterFromForm]
    private LoginInputModel? LoginInput { get; set; }

    [SupplyParameterFromForm]
    private RegisterInputModel? RegisterInput { get; set; }

    [SupplyParameterFromForm]
    private ResendInputModel? ResendInput { get; set; }

    // States
    private string? successMessage;
    private string? errorMessage;
    private string? infoMessage;
    private bool isSubmitting = false;

    private static readonly JsonSerializerOptions JsonOptions = new()
    {
        PropertyNameCaseInsensitive = true
    };

    protected override async Task OnInitializedAsync()
    {
        LoginInput ??= new();
        RegisterInput ??= new();
        ResendInput ??= new();

        successMessage = QuerySuccessMessage ?? QueryMessage;
        errorMessage = QueryErrorMessage;
        infoMessage = QueryInfoMessage;

        // Auto Verify jika mengakses /auth/verify-email
        if (IsRoute("/auth/verify-email"))
        {
            await HandleVerifyEmailAsync();
        }
    }

    private bool IsRoute(string relativePath)
    {
        var relativeUri = Navigation.ToBaseRelativePath(Navigation.Uri);
        var path = relativeUri.Split('?')[0]; // Ambil path tanpa query string
        return string.Equals($"/{path}".TrimEnd('/'), relativePath.TrimEnd('/'), StringComparison.OrdinalIgnoreCase);
    }

    private string GetPageTitle() => IsRoute("/auth/login") ? "Sign In" :
                                     IsRoute("/auth/register") ? "Create Account" :
                                     IsRoute("/auth/resend-verification") ? "Resend Email" :
                                     "Verify Email";

    private string GetPageSubtitle() => IsRoute("/auth/login") ? "Access your financial dashboard" :
                                        IsRoute("/auth/register") ? "Join Aumo Finance today" :
                                        IsRoute("/auth/resend-verification") ? "Request a new verification link" :
                                        "Confirming your email verification";

    private string GetPageIcon() => IsRoute("/auth/login") ? "bi-shield-lock-fill" :
                                    IsRoute("/auth/register") ? "bi-person-badge-fill" :
                                    IsRoute("/auth/resend-verification") ? "bi-envelope-at-fill" :
                                    "bi-patch-check-fill";

    // ----------------------------------------------------------------------------------
    // HANDLERS (Client-Side API Integration)
    // ----------------------------------------------------------------------------------

    private async Task HandleLoginAsync()
    {
        if (LoginInput == null) return;

        isSubmitting = true;
        errorMessage = null;

        try
        {
            var response = await Http.PostAsJsonAsync("api/v1/auth/login", new
            {
                Email = LoginInput.Email,
                Password = LoginInput.Password,
                RememberMe = LoginInput.RememberMe,
                IsMobileClient = false
            });

            var rawContent = await response.Content.ReadAsStringAsync();
            BackendLoginResponse? result = null;

            if (!string.IsNullOrWhiteSpace(rawContent))
            {
                try
                {
                    result = JsonSerializer.Deserialize<BackendLoginResponse>(rawContent, JsonOptions);
                }
                catch (JsonException)
                {
                    Logger.LogWarning("Respon dari backend bukan JSON yang valid: {Content}", rawContent);
                }
            }

            if (response.IsSuccessStatusCode && result?.Success == true)
            {
                Logger.LogInformation("User logged in successfully via API.");

                // Jika backend memberikan Bearer Token
                if (!string.IsNullOrEmpty(result.Token))
                {
                    Http.DefaultRequestHeaders.Authorization = 
                        new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", result.Token);
                }

                Navigation.NavigateTo("/", forceLoad: true);
                return;
            }

            if (result != null && result.LockoutEnd.HasValue)
            {
                var localLockout = result.LockoutEnd.Value.ToLocalTime();
                errorMessage = $"Akun Anda terkunci karena terlalu banyak percobaan login. Silakan tunggu hingga {localLockout:HH:mm:ss} WIB.";
            }
            else if (result != null && !string.IsNullOrWhiteSpace(result.Message))
            {
                errorMessage = result.Message;
            }
            else if (!response.IsSuccessStatusCode)
            {
                errorMessage = response.StatusCode switch
                {
                    System.Net.HttpStatusCode.Unauthorized => "Email atau password yang Anda masukkan salah.",
                    System.Net.HttpStatusCode.BadRequest => "Format data login tidak valid.",
                    System.Net.HttpStatusCode.TooManyRequests => "Terlalu banyak percobaan login. Silakan tunggu beberapa saat.",
                    _ => !string.IsNullOrWhiteSpace(rawContent) && !rawContent.StartsWith("<")
                        ? rawContent
                        : $"Gagal melakukan authentication ({response.StatusCode})."
                };
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error during login.");
            errorMessage = "Gagal terhubung ke server backend API.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task HandleRegisterAsync()
    {
        if (RegisterInput == null) return;

        isSubmitting = true;
        errorMessage = null;

        try
        {
            var response = await Http.PostAsJsonAsync("api/v1/auth/register", new
            {
                FullName = RegisterInput.FullName,
                Email = RegisterInput.Email,
                Password = RegisterInput.Password
            });

            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("/auth/login?successMessage=Account created successfully! Please check your email to verify your account.");
            }
            else
            {
                var rawContent = await response.Content.ReadAsStringAsync();
                errorMessage = !string.IsNullOrWhiteSpace(rawContent) && !rawContent.StartsWith("<") 
                    ? rawContent 
                    : "Registration failed. Please try again.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error during registration.");
            errorMessage = "Unable to connect to the backend server.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task HandleResendAsync()
    {
        if (ResendInput == null) return;

        isSubmitting = true;
        errorMessage = null;

        try
        {
            var response = await Http.PostAsJsonAsync("api/v1/auth/resend-verification", new
            {
                Email = ResendInput.Email
            });

            Navigation.NavigateTo("/auth/login?infoMessage=If that email is registered, a new verification link has been sent.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error during resend verification.");
            errorMessage = "Failed to send request. Please try again.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task HandleVerifyEmailAsync()
    {
        if (string.IsNullOrWhiteSpace(QueryEmail) || string.IsNullOrWhiteSpace(QueryToken))
        {
            errorMessage = "Invalid email verification link.";
            isSubmitting = false;
            return;
        }

        isSubmitting = true;

        try
        {
            var response = await Http.PostAsJsonAsync("api/v1/auth/verify-email", new
            {
                Email = QueryEmail,
                Token = QueryToken
            });

            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("/auth/login?successMessage=Email verified successfully! You can now sign in.");
            }
            else
            {
                errorMessage = "Failed to verify email. Link may have expired or is invalid.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error during email verification.");
            errorMessage = "An unexpected error occurred during email verification.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    // ----------------------------------------------------------------------------------
    // MODELS
    // ----------------------------------------------------------------------------------

    public class LoginInputModel
    {
        [Required(ErrorMessage = "Email address is required.")]
        [EmailAddress(ErrorMessage = "Please enter a valid email address.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Password is required.")]
        [DataType(DataType.Password)]
        public string Password { get; set; } = string.Empty;

        public bool RememberMe { get; set; }
    }

    public class RegisterInputModel
    {
        [Required(ErrorMessage = "Full Name is required.")]
        public string FullName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Email is required."), EmailAddress(ErrorMessage = "Invalid email address.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Password is required."), DataType(DataType.Password), StringLength(100, MinimumLength = 6, ErrorMessage = "Password must be at least 6 characters long.")]
        public string Password { get; set; } = string.Empty;
    }

    public class ResendInputModel
    {
        [Required(ErrorMessage = "Email is required."), EmailAddress(ErrorMessage = "Invalid email address.")]
        public string Email { get; set; } = string.Empty;
    }

    public class BackendLoginResponse
    {
        public bool Success { get; set; }
        public string Message { get; set; } = string.Empty;
        public string? UserId { get; set; }
        public string? FullName { get; set; }
        public string? Token { get; set; }
        public DateTime? LockoutEnd { get; set; }
    }
}
