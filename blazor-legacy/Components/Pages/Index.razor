@page "/"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing

@attribute [AllowAnonymous]
@rendermode InteractiveServer

<PageTitle>Aumo Finance - Integrated Financial Intelligence</PageTitle>

<div class="landing-viewport d-flex flex-column min-vh-100">
    <!-- Header / Navbar Minimalis -->
    <header class="navbar navbar-expand-lg navbar-dark px-3 px-md-5 py-3 border-bottom border-secondary border-opacity-25">
        <div class="container-fluid max-width-container">
            <a class="navbar-brand d-flex align-items-center gap-2 fw-bold fs-4 text-white" href="/">
                <div class="brand-icon rounded-circle d-flex align-items-center justify-content-center">
                    <i class="bi bi-shield-lock-fill text-primary fs-5"></i>
                </div>
                <span class="tracking-tight">Aumo<span class="text-primary">Finance</span></span>
            </a>

            <div class="d-flex align-items-center gap-3">
                <AuthorizeView>
                    <Authorized>
                        <NavLink href="/dashboard" class="btn btn-outline-light btn-sm rounded-pill px-3 py-1.5 fw-medium">
                            <i class="bi bi-speedometer2 me-1"></i> Dashboard
                        </NavLink>
                    </Authorized>
                    <NotAuthorized>
                        <NavLink href="/auth/login" class="btn btn-primary btn-sm rounded-pill px-4 py-1.5 fw-medium shadow-sm">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                        </NavLink>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </header>

    <!-- Main Hero Section -->
    <main class="flex-grow-1 d-flex align-items-center py-5">
        <div class="container max-width-container">
            <div class="row align-items-center gy-5">
                
                <!-- Hero Left: Text & CTA -->
                <div class="col-12 col-lg-7 text-start">
                    <div class="badge-status d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-4 border border-secondary border-opacity-25">
                        <span class="pulse-dot"></span>
                        <span class="small text-muted fw-medium">Financial Intelligence Platform v1.0</span>
                    </div>

                    <h1 class="display-4 fw-bold text-white tracking-tight mb-3 lh-sm">
                        Precision Accounting & <br class="d-none d-md-block" />
                        <span class="text-gradient">Financial Analytics</span>
                    </h1>

                    <p class="lead text-muted-custom mb-4 pe-lg-4">
                        Integrated core system for full-cycle general ledgers, trial balances, and operational accounting analytics built with enterprise-grade stability.
                    </p>

                    <div class="d-flex flex-wrap gap-3 align-items-center mb-5">
                        <AuthorizeView>
                            <Authorized>
                                <NavLink href="/dashboard" class="btn btn-primary btn-lg rounded-pill px-4 py-2.5 fw-medium shadow">
                                    <span>Buka Dashboard</span>
                                    <i class="bi bi-arrow-right me-1"></i>
                                </NavLink>
                            </Authorized>
                            <NotAuthorized>
                                <NavLink href="/auth/login" class="btn btn-primary btn-lg rounded-pill px-4 py-2.5 fw-medium shadow">
                                    <span>Access Platform</span>
                                    <i class="bi bi-arrow-right me-1"></i>
                                </NavLink>
                            </NotAuthorized>
                        </AuthorizeView>

                        <a href="#features" class="btn btn-outline-secondary btn-lg rounded-pill px-4 py-2.5 fw-medium text-white border-opacity-25">
                            Learn More
                        </a>
                    </div>

                    <!-- Highlight Badges -->
                    <div class="row g-3 border-top border-secondary border-opacity-25 pt-4">
                        <div class="col-4">
                            <h4 class="fw-bold text-white mb-0">99.9%</h4>
                            <p class="small text-muted mb-0">System Uptime</p>
                        </div>
                        <div class="col-4">
                            <h4 class="fw-bold text-white mb-0">Real-time</h4>
                            <p class="small text-muted mb-0">Ledger Audit</p>
                        </div>
                        <div class="col-4">
                            <h4 class="fw-bold text-white mb-0">AES-256</h4>
                            <p class="small text-muted mb-0">Data Security</p>
                        </div>
                    </div>
                </div>

                <!-- Hero Right: Interactive Visual Card -->
                <div class="col-12 col-lg-5">
                    <div class="hero-card border border-secondary border-opacity-25 rounded-4 p-4 shadow-lg position-relative overflow-hidden">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-cpu-fill text-primary fs-4"></i>
                                <span class="fw-bold text-white">System Status</span>
                            </div>
                            <span class="badge bg-success bg-opacity-25 text-success rounded-pill px-2.5 py-1 small">Operational</span>
                        </div>

                        <!-- System Metric Item -->
                        <div class="metric-box rounded-3 p-3 mb-3 border border-secondary border-opacity-10">
                            <div class="d-flex justify-content-between small text-muted mb-1">
                                <span>General Ledger Engine</span>
                                <span class="text-primary fw-medium">Active</span>
                            </div>
                            <div class="progress" style="height: 6px;">
                                <div class="progress-bar bg-primary" role="progressbar" style="width: 100%"></div>
                            </div>
                        </div>

                        <div class="metric-box rounded-3 p-3 mb-3 border border-secondary border-opacity-10">
                            <div class="d-flex justify-content-between small text-muted mb-1">
                                <span>Trial Balance Synchronizer</span>
                                <span class="text-success fw-medium">Synced</span>
                            </div>
                            <div class="progress" style="height: 6px;">
                                <div class="progress-bar bg-success" role="progressbar" style="width: 100%"></div>
                            </div>
                        </div>

                        <div class="p-3 rounded-3 bg-dark bg-opacity-50 border border-secondary border-opacity-10">
                            <p class="small text-muted mb-0">
                                <i class="bi bi-info-circle me-1 text-info"></i>
                                All core API services are verified and operational.
                            </p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </main>

    <!-- Simple Footer -->
    <footer class="py-4 border-top border-secondary border-opacity-25 text-center">
        <div class="container max-width-container">
            <p class="small text-muted mb-0">
                &copy; @DateTime.UtcNow.Year Aumo Finance. All rights reserved.
            </p>
        </div>
    </footer>
</div>

<style>
    /* Scope Styling: Premium Dark Financial Theme */
    .landing-viewport {
        background-color: var(--aumo-bg, #0D1117);
        color: var(--aumo-text, #FFFFFF);
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    }

    .max-width-container {
        max-width: 1140px;
    }

    .brand-icon {
        width: 36px;
        height: 36px;
        background-color: rgba(59, 130, 246, 0.15);
    }

    .badge-status {
        background-color: rgba(22, 27, 34, 0.8);
    }

    .pulse-dot {
        width: 8px;
        height: 8px;
        background-color: #10B981;
        border-radius: 50%;
        box-shadow: 0 0 8px #10B981;
    }

    .text-gradient {
        background: linear-gradient(135deg, #60A5FA 0%, #3B82F6 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .text-muted-custom {
        color: #9CA3AF;
    }

    .hero-card {
        background-color: var(--aumo-surface, #161B22);
        backdrop-filter: blur(12px);
    }

    .metric-box {
        background-color: rgba(13, 17, 23, 0.6);
    }

    .tracking-tight {
        letter-spacing: -0.025em;
    }
</style>
