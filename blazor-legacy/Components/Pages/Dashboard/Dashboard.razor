@page "/dashboard"
@using System.Globalization
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@rendermode InteractiveServer

@inject DashboardDataService DataService
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Financial Dashboard - Aumo Finance</PageTitle>

<style>
    .tracking-wider { letter-spacing: 0.05em; }
    .fs-8 { font-size: 0.75rem; }
    
    .glass-card {
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.08) !important;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        color: #ffffff !important;
    }
    
    [data-bs-theme="light"] .glass-card {
        background: rgba(255, 255, 255, 0.85);
        border-color: rgba(0, 0, 0, 0.06) !important;
        color: #212529 !important;
    }

    .glow-hover-success:hover { 
        border-color: rgba(25, 135, 84, 0.4) !important; 
        box-shadow: 0 8px 25px -6px rgba(25, 135, 84, 0.25) !important; 
        transform: translateY(-3px); 
    }
    .glow-hover-primary:hover { 
        border-color: rgba(13, 110, 253, 0.4) !important; 
        box-shadow: 0 8px 25px -6px rgba(13, 110, 253, 0.25) !important; 
        transform: translateY(-3px); 
    }
    .glow-hover-danger:hover { 
        border-color: rgba(220, 53, 69, 0.4) !important; 
        box-shadow: 0 8px 25px -6px rgba(220, 53, 69, 0.25) !important; 
        transform: translateY(-3px); 
    }

    .gradient-neon-blue {
        background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);
        box-shadow: 0 8px 20px -5px rgba(13, 110, 253, 0.4);
    }

    .icon-square { 
        width: 36px; 
        height: 36px; 
        display: flex; 
        align-items: center; 
        justify-content: center; 
    }

    .health-circle {
        width: 60px; 
        height: 60px; 
        border-radius: 50%;
        background: conic-gradient(var(--bs-primary) var(--score-deg), rgba(255,255,255,0.1) 0deg);
        display: flex; 
        align-items: center; 
        justify-content: center; 
        position: relative;
    }
    .health-circle::before { 
        content: ""; 
        position: absolute; 
        width: 48px; 
        height: 48px; 
        border-radius: 50%; 
        background: var(--bs-body-bg, #0d1117); 
    }
    .health-circle span { position: relative; z-index: 1; }

    .pulse-dot {
        width: 8px; 
        height: 8px; 
        border-radius: 50%; 
        background-color: #00ff66;
        box-shadow: 0 0 10px #00ff66, 0 0 20px #00ff66; 
        animation: pulse-animation 1.5s infinite;
    }
    @@keyframes pulse-animation {
        0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(0, 255, 102, 0.9); }
        70% { transform: scale(1); box-shadow: 0 0 0 10px rgba(0, 255, 102, 0); }
        100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(0, 255, 102, 0); }
    }

    .live-neon-text {
        color: #00ff66 !important; 
        text-shadow: 0 0 8px rgba(0, 255, 102, 0.8), 0 0 20px rgba(0, 255, 102, 0.5);
        animation: neon-blink 1.2s ease-in-out infinite alternate;
    }
    @@keyframes neon-blink {
        0% { opacity: 0.4; text-shadow: 0 0 2px rgba(0, 255, 102, 0.4); }
        100% { opacity: 1; text-shadow: 0 0 12px rgba(0, 255, 102, 1), 0 0 25px rgba(0, 255, 102, 0.8); }
    }

    .chart-container { position: relative; height: 280px; }
    .account-item { transition: background-color 0.15s ease; }
    .account-item:hover { background-color: rgba(255,255,255,0.04); }
</style>

<div class="container-fluid px-0 text-white">
    @if (UserId == Guid.Empty)
    {
        <div class="text-center py-5 my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="text-white-50 mt-3">Memuat data pengguna...</p>
        </div>
    }
    else if (!model.HasSelectedPeriod)
    {
        <div class="text-center py-5 my-5">
            <i class="bi bi-eye-slash text-secondary mb-3 d-block" style="font-size: 3rem;"></i>
            <h4 class="fw-bold text-white mb-2">No Period Selected</h4>
            <p class="text-white-50 mb-4">
                The Dashboard follows whichever period you're viewing.<br />
                Go to <strong>Periods</strong> and click <i class="bi bi-eye"></i> on a period to see its data here.
            </p>
            <a href="/periods" class="btn btn-primary fw-semibold shadow-sm px-4">
                <i class="bi bi-calendar3 me-1"></i> Go to Periods
            </a>
        </div>
    }
    else
    {
        <!-- Header Section -->
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="pulse-dot"></span>
                    <h4 class="fw-bold mb-0 text-white">Financial Overview</h4>
                </div>
                <p class="text-white-50 small mb-0">
                    Active Period: <span class="fw-semibold text-white">@model.ActivePeriodName</span>
                    @if (model.ActivePeriodStart.HasValue && model.ActivePeriodEnd.HasValue)
                    {
                        <span class="ms-1 text-white-50">
                            (@model.ActivePeriodStart.Value.ToString("dd MMM yyyy") &ndash; @model.ActivePeriodEnd.Value.ToString("dd MMM yyyy"))
                        </span>
                    }
                    &middot; <i class="bi bi-clock-history me-1"></i> <span class="fw-bold live-neon-text">Live updated</span>
                </p>
            </div>

            <div class="d-flex flex-wrap align-items-center gap-2">
                <div class="btn-group btn-group-sm p-1 bg-body-tertiary border border-opacity-10 rounded-pill shadow-sm" role="group">
                    <button type="button" 
                            @onclick='() => SwitchPeriod("monthly")'
                            class="btn btn-sm rounded-pill px-3 fw-semibold transition-all @(IsMonthly ? "btn-primary shadow-sm" : "btn-link text-white text-decoration-none opacity-75")">
                        Monthly
                    </button>
                    <button type="button" 
                            @onclick='() => SwitchPeriod("annual")'
                            class="btn btn-sm rounded-pill px-3 fw-semibold transition-all @(IsAnnual ? "btn-primary shadow-sm" : "btn-link text-white text-decoration-none opacity-75")">
                        Annual
                    </button>
                </div>

                <a href="/JournalEntry/Create" class="btn btn-warning btn-sm fw-semibold shadow-sm d-flex align-items-center gap-2 px-3 rounded-3">
                    <i class="bi bi-plus-lg"></i> New Entry
                </a>
                <a href="/Reports/IncomeStatement" class="btn btn-outline-light btn-sm d-flex align-items-center gap-2 px-3 rounded-3">
                    <i class="bi bi-file-earmark-bar-graph"></i> Report
                </a>
            </div>
        </div>

        <!-- Metrics Grid Section 1: Health Index & Runway -->
        <div class="row g-3 mb-4">
            <div class="col-12 col-md-6">
                <div class="card glass-card border-0 shadow-sm rounded-4 h-100 p-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-white-50 small fw-semibold text-uppercase tracking-wider">Financial Health Index</span>
                        <i class="bi bi-activity text-primary fs-5"></i>
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <div class="position-relative d-inline-flex align-items-center justify-content-center">
                            <div class="health-circle" style="--score-deg: @(model.FinancialHealthScore * 3.6)deg;">
                                <span class="fw-bold fs-4 text-white">@model.FinancialHealthScore</span>
                            </div>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-1">
                                @if (model.FinancialHealthScore >= 80) { <span class="text-success">Excellent Condition</span> }
                                else if (model.FinancialHealthScore >= 60) { <span class="text-info">Stable Operations</span> }
                                else { <span class="text-warning">Attention Required</span> }
                            </h6>
                            <p class="text-white-50 fs-8 mb-0">Analyzed from liquidity, debt coverage, and net profit margin.</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-6">
                <div class="card glass-card border-0 shadow-sm rounded-4 h-100 p-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-white-50 small fw-semibold text-uppercase tracking-wider">Cash Runway &amp; Burn Rate</span>
                        <i class="bi bi-speedometer2 text-warning fs-5"></i>
                    </div>
                    <div class="d-flex justify-content-between align-items-baseline mb-2">
                        <h4 class="fw-bold mb-0 text-white">
                            @(double.IsNaN(model.CashRunwayMonths) || double.IsInfinity(model.CashRunwayMonths) || model.CashRunwayMonths >= 99 ? "∞" : model.CashRunwayMonths.ToString("0.0"))
                            <span class="fs-6 text-white-50 fw-normal">Months Runway</span>
                        </h4>
                        <span class="fs-8 text-white-50">Burn: <strong class="text-white">@model.MonthlyBurnRate.ToString("C0", Idr)</strong>/mo</span>
                    </div>
                    <div class="progress rounded-pill bg-body-tertiary" style="height: 8px;">
                        <div class="progress-bar @(model.CashRunwayMonths > 6 ? "bg-success" : (model.CashRunwayMonths > 3 ? "bg-warning" : "bg-danger")) rounded-pill"
                             role="progressbar" style="width: @(Math.Min(model.CashRunwayMonths * 8.3, 100))%"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Metrics Grid Section 2: Core Financial Cards -->
        <div class="row g-3 mb-3">
            <!-- Cash & Equivalents -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card glass-card border-0 shadow-sm h-100 rounded-4 p-3 glow-hover-success">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-white-50 small fw-semibold text-uppercase tracking-wider">Cash &amp; Equivalents</span>
                        <div class="icon-square bg-success-subtle text-success rounded-3"><i class="bi bi-wallet2"></i></div>
                    </div>
                    <h4 class="fw-bold mb-1 text-white">@model.TotalCashAndEquivalents.ToString("C0", Idr)</h4>
                    <div class="small text-white-50 fs-8">Liquid Reserves</div>
                </div>
            </div>

            <!-- Revenue -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card glass-card border-0 shadow-sm h-100 rounded-4 p-3 glow-hover-primary">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-white-50 small fw-semibold text-uppercase tracking-wider">Revenue</span>
                        <div class="icon-square bg-primary-subtle text-primary rounded-3"><i class="bi bi-graph-up-arrow"></i></div>
                    </div>
                    <h4 class="fw-bold text-white mb-1">@model.RevenueThisPeriod.ToString("C0", Idr)</h4>
                    @{ decimal revTrend = model.RevenueTrendPercent ?? 0m; }
                    <div class="small @(revTrend >= 0m ? "text-success" : "text-danger") fs-8 fw-semibold">
                        <i class="bi @(revTrend >= 0m ? "bi-arrow-up-right" : "bi-arrow-down-right")"></i>
                        <span>@(Math.Abs(revTrend).ToString("0.0"))% vs prior</span>
                    </div>
                </div>
            </div>

            <!-- Expenses -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card glass-card border-0 shadow-sm h-100 rounded-4 p-3 glow-hover-danger">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-white-50 small fw-semibold text-uppercase tracking-wider">Expenses</span>
                        <div class="icon-square bg-danger-subtle text-danger rounded-3"><i class="bi bi-arrow-down-left-circle"></i></div>
                    </div>
                    <h4 class="fw-bold text-white mb-1">@model.OperatingExpenses.ToString("C0", Idr)</h4>
                    @{ decimal expTrend = model.ExpenseTrendPercent ?? 0m; }
                    <div class="small @(expTrend <= 0m ? "text-success" : "text-danger") fs-8 fw-semibold">
                        <i class="bi @(expTrend >= 0m ? "bi-arrow-up-right" : "bi-arrow-down-right")"></i>
                        <span>@(Math.Abs(expTrend).ToString("0.0"))% vs prior</span>
                    </div>
                </div>
            </div>

            <!-- Net Income -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm h-100 rounded-4 p-3 text-white gradient-neon-blue">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="small fw-semibold text-white-50 text-uppercase tracking-wider">Net Income</span>
                        <i class="bi bi-shield-check text-warning fs-5"></i>
                    </div>
                    <h4 class="fw-bold mb-1 text-white">@model.NetIncome.ToString("C0", Idr)</h4>
                    @{ decimal netTrend = model.NetIncomeTrendPercent ?? 0m; }
                    <div class="small @(netTrend >= 0m ? "text-success" : "text-danger") fs-8 fw-semibold">
                        <i class="bi @(netTrend >= 0m ? "bi-arrow-up-right" : "bi-arrow-down-right")"></i>
                        <span>@(Math.Abs(netTrend).ToString("0.0"))% vs prior</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Metrics Grid Section 3: Assets & Liabilities -->
        <div class="row g-3 mb-4">
            <div class="col-12 col-md-6">
                <div class="card glass-card border-0 shadow-sm h-100 rounded-4 p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-white-50 small fw-semibold text-uppercase tracking-wider d-block">Total Assets</span>
                            <h5 class="fw-bold mb-0 mt-1 text-white">@model.TotalAssets.ToString("C0", Idr)</h5>
                        </div>
                        <div class="icon-square bg-info-subtle text-info rounded-3 fs-5"><i class="bi bi-building"></i></div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6">
                <div class="card glass-card border-0 shadow-sm h-100 rounded-4 p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-white-50 small fw-semibold text-uppercase tracking-wider d-block">Total Liabilities</span>
                            <h5 class="fw-bold mb-0 mt-1 text-white">@model.TotalLiabilities.ToString("C0", Idr)</h5>
                        </div>
                        <div class="icon-square bg-warning-subtle text-warning rounded-3 fs-5"><i class="bi bi-credit-card"></i></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Charts Section -->
        <div class="row g-3 mb-4">
            <div class="col-12 col-xl-8">
                <div class="card glass-card border-0 shadow-sm rounded-4 h-100 p-3">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div>
                            <h6 class="fw-bold mb-0 text-white">Financial Trend</h6>
                            <span class="text-white-50 fs-8">Revenue vs Operating Expenses</span>
                        </div>
                        <div class="icon-square bg-primary-subtle text-primary rounded-3"><i class="bi bi-graph-up"></i></div>
                    </div>
                    <div class="chart-container"><canvas id="trendChart"></canvas></div>
                </div>
            </div>

            <div class="col-12 col-xl-4">
                <div class="card glass-card border-0 shadow-sm rounded-4 h-100 p-3">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div>
                            <h6 class="fw-bold mb-0 text-white">Expense Composition</h6>
                            <span class="text-white-50 fs-8">Breakdown by Account</span>
                        </div>
                        <div class="icon-square bg-danger-subtle text-danger rounded-3"><i class="bi bi-pie-chart"></i></div>
                    </div>

                    @if (model.HasExpenseData)
                    {
                        <div class="chart-container"><canvas id="expenseDoughnut"></canvas></div>
                    }
                    else
                    {
                        <div class="text-center text-white-50 py-4 d-flex flex-column align-items-center justify-content-center h-100">
                            <i class="bi bi-pie-chart fs-1 d-block mb-2 opacity-50"></i>
                            <span>No expense data for this period.</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Recent Tables Section -->
        <div class="row g-3">
            <div class="col-12 col-xl-6">
                <div class="card glass-card border-0 shadow-sm rounded-4 h-100 p-3">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h6 class="fw-bold mb-0 text-white">Key Accounts Overview</h6>
                        <a href="/ChartOfAccounts" class="btn btn-link btn-sm text-decoration-none p-0 fs-8 fw-semibold text-info">View All</a>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover table-borderless align-middle mb-0 text-white">
                            <thead class="text-white-50 fs-8 border-bottom border-secondary">
                                <tr>
                                    <th>CODE</th>
                                    <th>ACCOUNT NAME</th>
                                    <th class="text-end">BALANCE</th>
                                </tr>
                            </thead>
                            <tbody class="small">
                                @if (model.MainCoaBalances.Any())
                                {
                                    @foreach (var item in model.MainCoaBalances)
                                    {
                                        <tr class="account-item">
                                            <td class="fw-bold text-white-50">@item.AccountCode</td>
                                            <td class="fw-semibold text-white">@item.AccountName</td>
                                            <td class="text-end fw-bold text-white">@item.Balance.ToString("C0", Idr)</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="3" class="text-center text-white-50 py-3">No account balances found.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-6">
                <div class="card glass-card border-0 shadow-sm rounded-4 h-100 p-3">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h6 class="fw-bold mb-0 text-white">Recent Activity</h6>
                        <a href="/JournalEntry" class="btn btn-link btn-sm text-decoration-none p-0 fs-8 fw-semibold text-info">View All</a>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover table-borderless align-middle mb-0 text-white">
                            <thead class="text-white-50 fs-8 border-bottom border-secondary">
                                <tr>
                                    <th>DATE</th>
                                    <th class="text-end">DEBIT</th>
                                    <th class="text-end">CREDIT</th>
                                </tr>
                            </thead>
                            <tbody class="small">
                                @if (model.RecentJournals.Any())
                                {
                                    @foreach (var journal in model.RecentJournals)
                                    {
                                        <tr class="account-item">
                                            <td class="text-white-50">@journal.Date.ToString("dd MMM yyyy")</td>
                                            <td class="text-end fw-semibold text-success">@journal.TotalDebit.ToString("C0", Idr)</td>
                                            <td class="text-end fw-semibold text-danger">@journal.TotalCredit.ToString("C0", Idr)</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="3" class="text-center text-white-50 py-3">No recent journals recorded.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private Guid UserId;
    private static readonly CultureInfo Idr = new("id-ID");
    private DashboardViewModel model = new();
    private string periodType = "monthly";
    private bool chartsNeedRender;

    private bool IsMonthly => string.Equals(periodType, "monthly", StringComparison.OrdinalIgnoreCase);
    private bool IsAnnual => string.Equals(periodType, "annual", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            var userIdClaim = user.FindFirst(ClaimTypes.NameIdentifier);
            if (userIdClaim != null && Guid.TryParse(userIdClaim.Value, out var parsedId))
            {
                UserId = parsedId;

                var uri = new Uri(Nav.Uri);
                var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
                if (query.TryGetValue("period", out var p) && p.ToString().Equals("annual", StringComparison.OrdinalIgnoreCase))
                {
                    periodType = "annual";
                }

                await LoadDashboardAsync();
                return;
            }
        }

        Nav.NavigateTo("/Account/Login", true);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("initCommandPalette");
            }
            catch (JSException ex)
            {
                Console.WriteLine($"[JS Interop Warning] initCommandPalette: {ex.Message}");
            }
        }

        if (chartsNeedRender)
        {
            chartsNeedRender = false;
            try
            {
                await JS.InvokeVoidAsync("renderDashboardCharts", new
                {
                    trendData = new { labels = model.ChartLabels, revenue = model.ChartRevenue, expenses = model.ChartExpenses },
                    expenseData = new { labels = model.ExpenseCategoryLabels, values = model.ExpenseCategoryValues }
                });
            }
            catch (JSException ex)
            {
                Console.WriteLine($"[JS Interop Warning] renderDashboardCharts: {ex.Message}");
            }
        }
    }

    private async Task SwitchPeriod(string selectedPeriod)
    {
        if (periodType == selectedPeriod) return;
        periodType = selectedPeriod;
        await LoadDashboardAsync();
    }

    private async Task LoadDashboardAsync()
    {
        if (UserId == Guid.Empty) return;
        model = await DataService.GetDashboardDataAsync(UserId, periodType);
        chartsNeedRender = true;
        StateHasChanged();
    }
}