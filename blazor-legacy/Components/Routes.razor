@using Microsoft.AspNetCore.Components.Authorization
@using AumoBlazor

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(Program).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(Layout.MainLayout)">
                <Authorizing>
                    <div class="d-flex justify-content-center align-items-center vh-100">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading authentication state...</span>
                        </div>
                    </div>
                </Authorizing>
                <NotAuthorized Context="authContext">
                    @{
                        // Lakukan auto-redirect ke /auth/login tanpa memutus WebSocket circuit
                        var returnUrl = Uri.EscapeDataString(NavigationManager.ToBaseRelativePath(NavigationManager.Uri));
                        NavigationManager.NavigateTo($"/auth/login?ReturnUrl=%2F{returnUrl}", forceLoad: true);
                    }
                    <div class="container text-center mt-5 py-5">
                        <div class="card shadow-sm border-0 rounded-4 max-w-md mx-auto p-4">
                            <i class="bi bi-shield-lock text-warning display-4 mb-3"></i>
                            <h3 class="fw-bold">Access Denied</h3>
                            <p class="text-secondary">Redirecting to sign in...</p>
                        </div>
                    </div>
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>Not Found - Aumo Finance</PageTitle>
            <LayoutView Layout="@typeof(Layout.MainLayout)">
                <div class="container text-center mt-5 py-5">
                    <div class="card shadow-sm border-0 rounded-4 max-w-md mx-auto p-4">
                        <i class="bi bi-exclamation-triangle text-danger display-4 mb-3"></i>
                        <h3 class="fw-bold">Page Not Found</h3>
                        <p class="text-secondary">The page you requested could not be found.</p>
                        <div class="mt-3">
                            <NavLink class="btn btn-secondary px-4 fw-semibold" href="/">Return to Home</NavLink>
                        </div>
                    </div>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

@code {
    [Inject] private NavigationManager NavigationManager { get; set; } = default!;
}
