@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using AumoBlazor
@using AumoBlazor.Components.Layout

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(Program).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <Authorizing>
                    <div class="d-flex justify-content-center align-items-center vh-100">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading authentication state...</span>
                        </div>
                    </div>
                </Authorizing>
                <NotAuthorized Context="authContext">
                    @if (authContext.User.Identity?.IsAuthenticated != true)
                    {
                        <RedirectToLogin />
                    }
                    else
                    {
                        <div class="container text-center mt-5 py-5">
                            <div class="card shadow-sm border-0 rounded-4 mx-auto p-4" style="max-width: 450px;">
                                <i class="bi bi-shield-lock-fill text-warning display-4 mb-3"></i>
                                <h3 class="fw-bold">Akses Ditolak</h3>
                                <p class="text-secondary">Anda tidak memiliki izin untuk mengakses halaman ini.</p>
                                <div class="mt-3">
                                    <NavLink class="btn btn-primary px-4 fw-semibold" href="/">
                                        Kembali ke Dashboard
                                    </NavLink>
                                </div>
                            </div>
                        </div>
                    }
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>Not Found - Aumo Finance</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
                <div class="container text-center mt-5 py-5">
                    <div class="card shadow-sm border-0 rounded-4 mx-auto p-4" style="max-width: 450px;">
                        <i class="bi bi-exclamation-triangle text-danger display-4 mb-3"></i>
                        <h3 class="fw-bold">Page Not Found</h3>
                        <p class="text-secondary">The page you requested could not be found.</p>
                        <div class="mt-3">
                            <NavLink class="btn btn-secondary px-4 fw-semibold" href="/">
                                Return to Home
                            </NavLink>
                        </div>
                    </div>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
