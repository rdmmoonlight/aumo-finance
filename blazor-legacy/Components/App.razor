<!DOCTYPE html>
<html lang="en-US" data-bs-theme="dark">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <base href="/" />

    <!-- CSS Dependencies -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Aumo Theme Styles -->
    <link rel="stylesheet" href="css/guardian.css" />
    <link rel="stylesheet" href="css/theme/theme.css" />
    <link rel="stylesheet" href="css/theme/topbar.css" />
    <link rel="stylesheet" href="css/theme/sidebar.css" />

    <!-- Instant Theme Loader (Mencegah Flash/Flicker) -->
    <script>
        (function() {
            try {
                const savedTheme = localStorage.getItem('aumo_theme') || 'dark';
                document.documentElement.setAttribute('data-bs-theme', savedTheme);
            } catch (e) {
                document.documentElement.setAttribute('data-bs-theme', 'dark');
            }
        })();
    </script>

    <!-- HeadOutlet untuk Meta Data Dinamis -->
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <!-- Komponen Utama Routing dengan RenderMode InteractiveServer -->
    <Routes @rendermode="InteractiveServer" />

    <!-- UI Penanganan Error Blazor -->
    <div id="blazor-error-ui" class="alert alert-danger fixed-bottom m-3 d-none" role="alert">
        An unhandled error has occurred.
        <a href="" class="reload link-primary text-decoration-underline ms-2">Reload</a>
        <a class="dismiss link-secondary ms-2" style="cursor: pointer;">🗙</a>
    </div>

    <!-- JS Dependencies (Eksternal) -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Global Theme Controller Function -->
    <script>
        window.setAppTheme = function(themeName) {
            document.documentElement.setAttribute('data-bs-theme', themeName);
            localStorage.setItem('aumo_theme', themeName);
        };
    </script>

    <!-- Custom Scripts Aplikasi (Di-load Sebelum Blazor Script) -->
    <script src="js/site.js"></script>
    <script src="js/quran-banner.js"></script>

    <!-- Framework Blazor Core dengan Konfigurasi Auto-Reconnect (Memperbaiki WebSocket Disconnect di Render) -->
    <script src="_framework/blazor.web.js" autostart="false"></script>
    <script>
        Blazor.start({
            circuit: {
                reconnectionOptions: {
                    maxRetries: 10,
                    retryIntervalMilliseconds: 2000,
                    dialogOptions: {
                        showModal: false
                    }
                }
            }
        });
    </script>

    <!-- Guardian.js Di-load Paling Akhir setelah Blazor Siap -->
    <script src="js/guardian.js"></script>
</body>

</html>
