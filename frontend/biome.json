{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/routeTree.gen.ts",
      "!node_modules",
      "!dist",
      "!.tanstack",
      "!src/components/ui/**"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noDocumentCookie": "off"
      }
    }
  }
}
