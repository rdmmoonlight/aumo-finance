<resources>
    <!-- Warna latar window (tampil sebelum Compose pertama kali digambar).
         Nilainya harus sama dengan AumoColors di ui/theme/Theme.kt. -->
    <color name="colorPrimary">#523363</color>
    <color name="colorBackground">#0A0A0A</color>

    <!-- Warna latar adaptive icon (dirujuk mipmap-anydpi-v26/ic_launcher*.xml). -->
    <color name="ic_launcher_background">#0A0A0A</color>

    <!-- Tema platform tanpa ActionBar: seluruh UI digambar oleh Compose
         (lihat AumoTheme), tema XML hanya mengatur window. -->
    <style name="Theme.AumoFinance" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/colorPrimary</item>
        <item name="android:windowBackground">@color/colorBackground</item>
    </style>
</resources>
