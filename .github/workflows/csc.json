{
  "problemMatcher": [
    {
      "owner": "csc",
      "pattern": [
        {
          "regexp": "^\\s*([^\\\\s].*)\\((\\d+|\\d+,\\d+|\\d+,\\d+,\\d+,\\d+)\\):\\s+(error|warning|info)\\s+([A-Z0-9]+):\\s+(.*)$",
          "file": 1,
          "location": 2,
          "severity": 3,
          "code": 4,
          "message": 5
        }
      ]
    }
  ]
}
