    "cross-env": "^10.1.0",
    "eslint": "^9.20.0",
    "postcss": "^8.5.0",
    "prettier": "^3.5.0",
    "rimraf": "^6.1.3",
    "typescript": "~5.7.3",
    "vite": "^8.3.2",
    "vite-tsconfig-paths": "^6.1.1"
