{
  "name": "aumo-backend",
  "version": "3.2.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "clean": "rimraf dist .tscache tsconfig.tsbuildinfo node_modules/.cache",
    "dev": "tsx watch src/index.ts",
    "prebuild": "npm run clean",
    "build": "tsup",
    "prestart": "npm run build",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@better-auth/drizzle-adapter": "^1.7.7",
    "@hono/node-server": "^2.1.3",
    "@hono/zod-openapi": "^1.6.3",
    "@hono/zod-validator": "^0.9.1",
    "@neon/config": "^1.8.4",
    "@neon/env": "^1.5.1",
    "@neondatabase/serverless": "^1.2.0",
    "@scalar/hono-api-reference": "^0.12.10",
    "bcrypt": "^6.0.0",
    "better-auth": "^1.7.7",
    "bullmq": "^6.3.11",
    "dotenv": "^18.0.5",
    "drizzle-orm": "^1.0.0-rc.4",
    "google-auth-library": "^11.1.0",
    "hono": "^4.13.13",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/ioredis": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "drizzle-kit": "^1.0.0-rc.4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "pino-pretty": "^13.2.0",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}