{
  "version": 3,
  "configurePresets": [
    {
      "name": "ubuntu-debug",
      "displayName": "Ubuntu 24.04 GCC (Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-debug",
      "configurePreset": "ubuntu-debug"
    }
  ]
}
