@inherits LayoutComponentBase

<div class="aumo-main-shell vh-100 vw-100 d-flex flex-column overflow-hidden bg-light">

    <!-- 1. TOPBAR (Fixed di Paling Atas) -->
    <header class="topbar-container flex-shrink-0 w-100 z-3 border-bottom bg-white shadow-sm">
        <AumoBlazor.Components.Layout.AppTopBar />
    </header>

    <!-- 2. SHELL UTAMA (Sidebar + Content) -->
    <div class="aumo-body-shell flex-grow-1 d-flex flex-row overflow-hidden position-relative">
        
        <!-- SIDEBAR / NAVMENU (Fixed Scroll Sendiri jika Menu Panjang) -->
        <aside class="sidebar-container flex-shrink-0 overflow-y-auto bg-white border-end shadow-sm">
            <AumoBlazor.Components.Layout.NavMenu />
        </aside>

        <!-- MAIN CONTENT AREA (Kanan - Berdiri Sendiri dengan Scrollbar Sendiri) -->
        <main id="mainContent" class="content flex-grow-1 overflow-y-auto p-3 p-md-4 d-flex flex-column min-w-0" role="main">
            <div class="container-fluid p-0 flex-grow-1">
                @Body
            </div>
        </main>

    </div>

</div>

/* Variable Tema Global Scope MainLayout */
:root,
[data-bs-theme="dark"] {
    --aumo-bg: #0D1117;
    --aumo-surface: #161B22;
    --aumo-text: #FFFFFF;
    --aumo-text-muted: #94A3B8;
    --aumo-border: #2A313C;
    --font-heading: "Space Grotesk", sans-serif;
    --font-body: "Inter", sans-serif;
}

[data-bs-theme="light"] {
    --aumo-bg: #FFFFFF;
    --aumo-surface: #FFFFFF;
    --aumo-text: #0F172A;
    --aumo-text-muted: #64748B;
    --aumo-border: #E2E8F0;
}

.aumo-main-shell {
    background-color: var(--aumo-bg);
    color: var(--aumo-text);
    font-family: var(--font-body);
}

/* KUNCI FLEXBOX LAYOUT (Side-by-Side Protection) */
.aumo-body-shell {
    display: flex !important;
    flex-direction: row !important;
    align-items: stretch !important;
    width: 100% !important;
}

.sidebar-container {
    display: flex !important;
    flex-shrink: 0 !important;
    z-index: 100;
}

/* Memaksa Main Content Tetap Sejajar di Kanan Sidebar */
#mainContent {
    background-color: var(--aumo-bg);
    color: var(--aumo-text);
    flex: 1 1 auto !important;
    min-width: 0 !important;
    width: auto !important;
}

::deep h1, ::deep h2, ::deep h3, ::deep h4, ::deep h5, ::deep h6 {
    font-family: var(--font-heading);
}
