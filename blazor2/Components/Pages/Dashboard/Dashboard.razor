@page "/dashboard"
@using System.Net.Http.Json
@using AumoBlazor.ViewModels
@inject HttpClient Http

<PageTitle>Dashboard</PageTitle>

<div class="container-fluid my-4">
    <h3 class="mb-4">Dashboard Keuangan</h3>

    @if (vm == null)
    {
        <p><em>Loading dashboard dari Hono API...</em></p>
    }
    else
    {
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card shadow-sm border-0 bg-primary text-white p-3">
                    <h6>Kas & Setara Kas</h6>
                    <h4>@vm.TotalCashAndEquivalents.ToString("N0")</h4>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card shadow-sm border-0 bg-success text-white p-3">
                    <h6>Pendapatan Periode Ini</h6>
                    <h4>@vm.RevenueThisPeriod.ToString("N0")</h4>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card shadow-sm border-0 bg-warning text-dark p-3">
                    <h6>Beban Operasional</h6>
                    <h4>@vm.OperatingExpenses.ToString("N0")</h4>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card shadow-sm border-0 bg-info text-white p-3">
                    <h6>Laba Bersih</h6>
                    <h4>@vm.NetIncome.ToString("N0")</h4>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private DashboardViewModel? vm;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            vm = await Http.GetFromJsonAsync<DashboardViewModel>("api/dashboard") ?? new DashboardViewModel();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetch dashboard: {ex.Message}");
            vm = new DashboardViewModel();
        }
    }
}
