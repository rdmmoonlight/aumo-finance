@page "/"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing

@attribute [AllowAnonymous]
@rendermode InteractiveServer

<PageTitle>Aumo Finance - Integrated Financial Intelligence</PageTitle>

<div class="landing-hero min-vh-100 d-flex flex-column justify-content-between py-4">
    <!-- Navbar / Header Section -->
    <header class="container d-flex justify-content-between align-items-center mb-5">
        <div class="d-flex align-items-center gap-2">
            <span class="fs-3 fw-bold text-primary">Aumo</span>
            <span class="fs-3 fw-light text-secondary">Finance</span>
        </div>
        <div class="d-flex gap-2">
            <a href="/login" class="btn btn-outline-primary px-4 fw-semibold">
                Sign In
            </a>
            <a href="/register" class="btn btn-primary px-4 fw-semibold shadow-sm">
                Get Started
            </a>
        </div>
    </header>

    <!-- Main Hero Section -->
    <main class="container my-auto py-4">
        <div class="row align-items-center gy-5">
            <div class="col-lg-7">
                <span class="badge bg-primary-subtle text-primary mb-3 px-3 py-2 fs-6 rounded-pill">
                    Enterprise-Grade Financial System
                </span>
                
                <h1 class="display-3 fw-bold tracking-tight mb-3">
                    Precision Accounting & <span class="text-primary">Financial Intelligence</span>
                </h1>

                <p class="lead text-secondary mb-4 col-lg-10 fs-5">
                    Integrated core system for full-cycle general ledgers, trial balances, and operational accounting analytics built with maximum stability and control.
                </p>

                <div class="d-flex flex-wrap gap-3 mb-5">
                    <a href="/register" class="btn btn-primary btn-lg px-4 py-3 fw-semibold shadow-sm d-flex align-items-center gap-2">
                        Create Free Account
                        <i class="bi bi-arrow-right"></i>
                    </a>
                    <a href="/login" class="btn btn-outline-secondary btn-lg px-4 py-3 fw-semibold">
                        Sign In to Portal
                    </a>
                </div>

                <!-- Trust Metrics / Highlights -->
                <div class="row g-4 pt-4 border-top">
                    <div class="col-4">
                        <h4 class="fw-bold mb-0">100%</h4>
                        <small class="text-muted">Ledger Accuracy</small>
                    </div>
                    <div class="col-4">
                        <h4 class="fw-bold mb-0">Real-Time</h4>
                        <small class="text-muted">Trial Balances</small>
                    </div>
                    <div class="col-4">
                        <h4 class="fw-bold mb-0">Audit-Ready</h4>
                        <small class="text-muted">Full Compliance</small>
                    </div>
                </div>
            </div>

            <!-- Visual / Card Preview -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-lg rounded-4 p-4 bg-body-tertiary">
                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <div>
                            <h6 class="text-muted mb-1">Total Balance</h6>
                            <h3 class="fw-bold mb-0">$2,485,920.00</h3>
                        </div>
                        <span class="badge bg-success-subtle text-success p-2">
                            +12.4% MoM
                        </span>
                    </div>

                    <div class="p-3 bg-body rounded-3 mb-3 border">
                        <div class="d-flex justify-content-between text-muted small mb-1">
                            <span>General Ledger Sync</span>
                            <span class="text-success fw-bold">Active</span>
                        </div>
                        <div class="progress" style="height: 6px;">
                            <div class="progress-bar bg-primary" role="progressbar" style="width: 85%"></div>
                        </div>
                    </div>

                    <div class="p-3 bg-body rounded-3 border">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted d-block">System Status</small>
                                <span class="fw-semibold small">Operational Accounting Analytics</span>
                            </div>
                            <span class="badge bg-primary">Live</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- Footer Simple -->
    <footer class="container text-center py-3 text-muted border-top">
        <small>&copy; @DateTime.Now.Year Aumo Finance. All rights reserved.</small>
    </footer>
</div>
