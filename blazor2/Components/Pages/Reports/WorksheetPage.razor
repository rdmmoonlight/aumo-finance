@page "/reports/worksheet"
@using AumoBlazor.ViewModels
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>Kertas Kerja (Worksheet)</PageTitle>

<div class="container-fluid my-4">
    <h3 class="mb-4">Kertas Kerja (Worksheet)</h3>

    <div class="card shadow-sm">
        <div class="card-body">
            @if (vm == null)
            {
                <p><em>Loading data dari Hono API...</em></p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-sm align-middle text-nowrap">
                        <thead>
                            <tr>
                                <th>Kode</th>
                                <th>Nama Akun</th>
                                <th colspan="2" class="text-center">Neraca Saldo Belum Disesuaikan</th>
                                <th colspan="2" class="text-center">Penyesuaian</th>
                                <th colspan="2" class="text-center">Neraca Saldo Disesuaikan</th>
                                <th colspan="2" class="text-center">Laba Rugi</th>
                                <th colspan="2" class="text-center">Posisi Keuangan</th>
                            </tr>
                            <tr>
                                <th></th>
                                <th></th>
                                <th class="text-end">Debit</th>
                                <th class="text-end">Kredit</th>
                                <th class="text-end">Debit</th>
                                <th class="text-end">Kredit</th>
                                <th class="text-end">Debit</th>
                                <th class="text-end">Kredit</th>
                                <th class="text-end">Debit</th>
                                <th class="text-end">Kredit</th>
                                <th class="text-end">Debit</th>
                                <th class="text-end">Kredit</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in vm.Rows)
                            {
                                <tr>
                                    <td>@r.AccountCode</td>
                                    <td>@r.AccountName</td>
                                    <td class="text-end">@r.UnadjustedDebit.ToString("N2")</td>
                                    <td class="text-end">@r.UnadjustedCredit.ToString("N2")</td>
                                    <td class="text-end">@r.AdjustmentDebit.ToString("N2")</td>
                                    <td class="text-end">@r.AdjustmentCredit.ToString("N2")</td>
                                    <td class="text-end">@r.AdjustedDebit.ToString("N2")</td>
                                    <td class="text-end">@r.AdjustedCredit.ToString("N2")</td>
                                    <td class="text-end">@r.IncomeStatementDebit.ToString("N2")</td>
                                    <td class="text-end">@r.IncomeStatementCredit.ToString("N2")</td>
                                    <td class="text-end">@r.FinancialPositionDebit.ToString("N2")</td>
                                    <td class="text-end">@r.FinancialPositionCredit.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="fw-bold">
                                <td colspan="2">Total</td>
                                <td class="text-end">@vm.TotalUnadjustedDebit.ToString("N2")</td>
                                <td class="text-end">@vm.TotalUnadjustedCredit.ToString("N2")</td>
                                <td class="text-end">@vm.TotalAdjustmentDebit.ToString("N2")</td>
                                <td class="text-end">@vm.TotalAdjustmentCredit.ToString("N2")</td>
                                <td class="text-end">@vm.TotalAdjustedDebit.ToString("N2")</td>
                                <td class="text-end">@vm.TotalAdjustedCredit.ToString("N2")</td>
                                <td class="text-end">@vm.TotalIncomeStatementDebit.ToString("N2")</td>
                                <td class="text-end">@vm.TotalIncomeStatementCredit.ToString("N2")</td>
                                <td class="text-end">@vm.TotalFinancialPositionDebit.ToString("N2")</td>
                                <td class="text-end">@vm.TotalFinancialPositionCredit.ToString("N2")</td>
                            </tr>
                            <tr class="fw-bold table-info">
                                <td colspan="8">Laba Bersih</td>
                                <td colspan="2" class="text-center">@vm.NetIncome.ToString("N2")</td>
                                <td colspan="2" class="text-center">@vm.NetIncome.ToString("N2")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private WorksheetViewModel? vm;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            vm = await Http.GetFromJsonAsync<WorksheetViewModel>("api/reports/worksheet");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetch Worksheet: {ex.Message}");
            vm = new WorksheetViewModel();
        }
    }
}
