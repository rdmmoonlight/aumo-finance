@page "/reports/trial-balance"
@using AumoBlazor.ViewModels
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>Trial Balance</PageTitle>

<div class="container-fluid my-4">
    <h3 class="mb-4">Trial Balance</h3>

    <div class="card shadow-sm">
        <div class="card-body">
            @if (rows == null)
            {
                <p><em>Loading data dari Hono API...</em></p>
            }
            else if (!rows.Any())
            {
                <p>Tidak ada data neraca saldo ditemukan.</p>
            }
            else
            {
                <table class="table table-striped table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Kode Akun</th>
                            <th>Nama Akun</th>
                            <th class="text-end">Debit</th>
                            <th class="text-end">Kredit</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in rows)
                        {
                            <tr>
                                <td>@row.AccountCode</td>
                                <td>@row.AccountName</td>
                                <td class="text-end">@row.Debit.ToString("N2")</td>
                                <td class="text-end">@row.Credit.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>

@code {
    private List<TrialBalanceRowViewModel>? rows;

    protected override async Task OnInitializedAsync()
    {
        await LoadTrialBalanceAsync();
    }

    private async Task LoadTrialBalanceAsync()
    {
        try
        {
            rows = await Http.GetFromJsonAsync<List<TrialBalanceRowViewModel>>("api/reports/trial-balance");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetch Hono API: {ex.Message}");
            rows = new List<TrialBalanceRowViewModel>();
        }
    }
}
