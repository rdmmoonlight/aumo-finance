@page "/settings"
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>Settings</PageTitle>

<div class="container my-4">
    <h3 class="mb-4">Settings</h3>

    @if (!string.IsNullOrEmpty(statusAlertMessage))
    {
        <div class="alert @statusAlertClass alert-dismissible fade show" role="alert">
            @statusAlertMessage
            <button type="button" class="btn-close" @onclick="() => statusAlertMessage = null"></button>
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white"><strong>Profil Pengguna</strong></div>
        <div class="card-body">
            <div class="mb-3">
                <label class="form-label">Nama Lengkap</label>
                <input type="text" class="form-control" @bind="UserFullName" />
            </div>
            <div class="mb-3">
                <label class="form-label">Username</label>
                <input type="text" class="form-control" @bind="UserName" readonly />
            </div>
            <div class="mb-3">
                <label class="form-label">Email</label>
                <input type="email" class="form-control" @bind="UserEmail" />
            </div>
            <div class="mb-3">
                <span class="badge @(IsEmailConfirmed ? "bg-success" : "bg-warning text-dark")">
                    @(IsEmailConfirmed ? "Email Terverifikasi" : "Email Belum Terverifikasi")
                </span>
                @if (!IsEmailConfirmed)
                {
                    <button class="btn btn-sm btn-outline-primary ms-2" @onclick="ResendVerificationEmail" disabled="@isSendingEmail">
                        @(isSendingEmail ? "Mengirim..." : "Kirim Ulang Verifikasi")
                    </button>
                }
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white"><strong>Pengaturan Tampilan & Sistem</strong></div>
        <div class="card-body">
            <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" id="darkModeSwitch" @bind="isDarkMode" @bind:after="OnThemeChanged" />
                <label class="form-check-label" for="darkModeSwitch">Mode Gelap (Dark Mode)</label>
            </div>
            <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" id="systemAlertsSwitch" @bind="enableSystemAlerts" @bind:after="OnSystemAlertsChanged" />
                <label class="form-check-label" for="systemAlertsSwitch">Aktifkan Notifikasi Sistem</label>
            </div>
        </div>
    </div>
</div>

@code {
    private string? statusAlertMessage;
    private string statusAlertClass = "alert-info";
    private string UserFullName = "Ghofur User";
    private string UserName = "ghofur";
    private string UserEmail = "user@aumo.com";
    private bool IsEmailConfirmed = true;
    private bool isSendingEmail = false;
    private bool isDarkMode = false;
    private bool enableSystemAlerts = true;
    private string CurrentUser = "Ghofur";
    private string toastMessage = "";

    private async Task ResendVerificationEmail()
    {
        isSendingEmail = true;
        await Task.Delay(1000);
        statusAlertMessage = "Email verifikasi telah dikirim.";
        statusAlertClass = "alert-success";
        isSendingEmail = false;
    }

    private void OnThemeChanged() { }
    private void OnSystemAlertsChanged() { }
}
