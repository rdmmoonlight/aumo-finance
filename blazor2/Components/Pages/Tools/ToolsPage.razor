@page "/tools"
@using System.Globalization
@inject HttpClient Http

<PageTitle>Tools</PageTitle>

<div class="container my-4">
    <h3 class="mb-4">Tools & Utility</h3>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success">@successMessage</div>
    }
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-header">Import Jurnal</div>
        <div class="card-body">
            <InputFile OnChange="OnFileSelected" class="form-control mb-3" />
            <button class="btn btn-primary" @onclick="HandlePreview" disabled="@(selectedFile == null || isBusy)">Preview</button>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header">Maintenance</div>
        <div class="card-body">
            <button class="btn btn-warning me-2" @onclick="HandleRecalculateLedger" disabled="@isBusy">Recalculate Ledger</button>
            <button class="btn btn-secondary" @onclick="HandleBackupDatabase" disabled="@isBusy">Backup Database</button>
        </div>
    </div>
</div>

@code {
    private string? successMessage;
    private string? errorMessage;
    private bool isBusy = false;
    private Microsoft.AspNetCore.Components.Forms.IBrowserFile? selectedFile;
    private string parseResult = "";
    private CultureInfo Idr = new CultureInfo("id-ID");

    private void OnFileSelected(Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
    }

    private async Task HandleDownloadJournalTemplate() { await Task.Yield(); }
    private async Task HandlePreview() { await Task.Yield(); }
    private async Task HandleRecalculateLedger() { await Task.Yield(); }
    private async Task HandleBackupDatabase() { await Task.Yield(); }
    private async Task HandleConfirmImport() { await Task.Yield(); }
}
