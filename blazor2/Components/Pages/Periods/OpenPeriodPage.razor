@page "/periods/open"
@using AumoBlazor.ViewModels
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Buka Periode Akuntansi</PageTitle>

<div class="container my-4">
    <h3 class="mb-4">Buka Periode Akuntansi Baru</h3>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Bulan</label>
                    <select class="form-select" @bind="Model.Month">
                        @for (int m = 1; m <= 12; m++)
                        {
                            <option value="@m">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Tahun</label>
                    <input type="number" class="form-control" @bind="Model.Year" min="2000" max="2100" />
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white"><strong>Opsi Pengaturan Akun Permanent</strong></div>
        <div class="card-body">
            <div class="form-check mb-2">
                <input class="form-check-input" type="radio" name="setupMode" id="modeLoad"
                       value="@OpenPeriodViewModel.ModeLoadExisting"
                       checked="@(Model.SetupMode == OpenPeriodViewModel.ModeLoadExisting)"
                       @onchange="() => Model.SetupMode = OpenPeriodViewModel.ModeLoadExisting" />
                <label class="form-check-label" for="modeLoad">
                    Gunakan akun permanen yang sudah ada dari periode sebelumnya
                </label>
            </div>
            <div class="form-check mb-3">
                <input class="form-check-input" type="radio" name="setupMode" id="modeCreate"
                       value="@OpenPeriodViewModel.ModeCreateNew"
                       checked="@(Model.SetupMode == OpenPeriodViewModel.ModeCreateNew)"
                       @onchange="() => Model.SetupMode = OpenPeriodViewModel.ModeCreateNew" />
                <label class="form-check-label" for="modeCreate">
                    Buat akun permanen baru (Inisialisasi)
                </label>
            </div>

            @if (Model.SetupMode == OpenPeriodViewModel.ModeLoadExisting)
            {
                <div class="mb-3">
                    <label class="form-label">Akun Kas</label>
                    <select class="form-select" @bind="Model.CashAccountId">
                        @foreach (var acc in Model.AvailableCashAndBankAccounts)
                        {
                            <option value="@acc.Id">@acc.Code - @acc.Name</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Akun Bank</label>
                    <select class="form-select" @bind="Model.BankAccountId">
                        @foreach (var acc in Model.AvailableCashAndBankAccounts)
                        {
                            <option value="@acc.Id">@acc.Code - @acc.Name</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Akun Laba Ditahan</label>
                    <select class="form-select" @bind="Model.RetainedEarningsAccountId">
                        @foreach (var acc in Model.AvailableRetainedEarningsAccounts)
                        {
                            <option value="@acc.Id">@acc.Code - @acc.Name</option>
                        }
                    </select>
                </div>
            }
            else
            {
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label">Kode Kas</label>
                        <input class="form-control" @bind="Model.CashAccountCode" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Nama Kas</label>
                        <input class="form-control" @bind="Model.CashAccountName" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Saldo Awal Kas</label>
                        <input type="number" class="form-control text-end" @bind="Model.CashBalance" />
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label">Kode Bank</label>
                        <input class="form-control" @bind="Model.BankAccountCode" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Nama Bank</label>
                        <input class="form-control" @bind="Model.BankAccountName" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Saldo Awal Bank</label>
                        <input type="number" class="form-control text-end" @bind="Model.BankBalance" />
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Kode Laba Ditahan</label>
                        <input class="form-control" @bind="Model.RetainedEarningsAccountCode" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Nama Laba Ditahan</label>
                        <input class="form-control" @bind="Model.RetainedEarningsAccountName" />
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2">
        <button class="btn btn-secondary" @onclick="Cancel">Batal</button>
        <button class="btn btn-primary" @onclick="HandleSubmit" disabled="@isSubmitting">
            @(isSubmitting ? "Memproses..." : "Buka Periode")
        </button>
    </div>
</div>

@code {
    private OpenPeriodViewModel Model = new();
    private bool isSubmitting = false;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadInitialDataAsync();
    }

    private async Task LoadInitialDataAsync()
    {
        try
        {
            var res = await Http.GetFromJsonAsync<OpenPeriodViewModel>("api/periods/open-options");
            if (res != null)
            {
                Model = res;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Gagal memuat opsi periode: {ex.Message}";
        }
    }

    private async Task HandleSubmit()
    {
        isSubmitting = true;
        errorMessage = null;

        try
        {
            var response = await Http.PostAsJsonAsync("api/periods/open", Model);
            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("/periods");
            }
            else
            {
                errorMessage = await response.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saat membuka periode: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/periods");
    }
}
